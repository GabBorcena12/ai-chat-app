                            <div class="eyebrow">Validation</div>
                            <h2>@(EditingKnowledgeId.HasValue ? "Edit Knowledge Entry" : "Create Knowledge Entry")</h2>
                            <p>Update the published assistant knowledge without touching code files.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close knowledge entry" @onclick="CloseKnowledgeModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="knowledge-edit-modal-body">
                        <div class="backoffice-grid knowledge-edit-grid">
                            <label>
                                <span title="Choose whether this entry is a quick answer, topic summary, or reference content.">Entry type</span>
                                <select class="text-input" @bind="KnowledgeModalDraft.EntryType">
                                    <option>QuickAnswer</option>
                                    <option>Topic</option>
                                    <option>Reference</option>
                                </select>
                            </label>
                            <label>
                                <span title="Logical bucket or source name used to group knowledge entries.">Source name</span>
                                <input class="text-input" @bind="KnowledgeModalDraft.SourceName" />
                            </label>
                            <label class="backoffice-wide">
                                <span title="Admin-facing title for this knowledge record.">Title</span>
                                <input class="text-input" @bind="KnowledgeModalDraft.Title" />
                            </label>
                            <label class="backoffice-wide">
                                <span title="Optional short summary, especially useful for topic entries.">Summary</span>
                                <input class="text-input" @bind="KnowledgeModalDraft.Summary" />
                            </label>
                            <label class="backoffice-wide">
                                <span title="The main reusable content the assistant can read from this entry.">Content</span>
                                <textarea class="text-input backoffice-textarea knowledge-content-textarea" rows="10" @bind="KnowledgeModalDraft.Content"></textarea>
                            </label>
                        </div>

                        <div class="backoffice-inline-options knowledge-edit-options">
                            <label title="Published entries are active and available to the assistant.">
                                <input type="checkbox" @bind="KnowledgeModalDraft.IsPublished" />
                                Published
                            </label>
                        </div>
                    </div>

                    <div class="backoffice-modal-actions">
                        <button type="button" class="ghost-button icon-label-button" @onclick="CloseKnowledgeModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                            Cancel
                        </button>
                        <button type="button" class="primary-action slim icon-label-button" @onclick="SaveKnowledgeModalAsync" disabled="@isBusy">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
                                <path d="M17 21v-8H7v8" />
                                <path d="M7 3v5h8" />
                            </svg>
                            @(EditingKnowledgeId.HasValue ? "Save entry" : "Create entry")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (ShowReportModal && SelectedReport is not null)
        {
            var draft = GetReviewDraft(SelectedReport);
            <div class="backoffice-modal-backdrop" @onclick="CloseReportModal">
                <div class="backoffice-modal admin-management-modal report-review-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Validation</div>
                            <h2>Review Report #@SelectedReport.Id</h2>
                            <p>Validate the answer, classify the issue, and optionally promote the fix into reusable knowledge.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close report review" @onclick="CloseReportModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="report-review-body">
                        <div class="backoffice-card backoffice-review-source">
                            <div class="report-source-meta">
                                <span class="report-source-user">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M20 21a8 8 0 0 0-16 0" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                    @SelectedReport.Username
                                </span>
                                <span class="source-dot">•</span>
                                <span class="report-status-chip">@GetReportStatusLabel(SelectedReport)</span>
                                @if (!string.IsNullOrWhiteSpace(SelectedReport.ReviewCategory))
                                {
                                    <span class="source-dot">•</span>
                                    <span>@SelectedReport.ReviewCategory</span>
                                }
                                <span class="source-dot">•</span>
                                <span class="report-source-date">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M8 2v4" />
                                        <path d="M16 2v4" />
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <path d="M3 10h18" />
                                    </svg>
                                    @FormatReportTimestamp(SelectedReport)
                                </span>
                            </div>
                            <p class="backoffice-list-summary"><strong>Original prompt:</strong> @SelectedReport.UserPrompt</p>
                            <p class="backoffice-list-summary"><strong>Original response:</strong> @SelectedReport.AssistantResponse</p>
                        </div>

                        <div class="review-workflow-guide">
                            <div class="review-workflow-step active">
                                <span class="workflow-step-marker"></span>
                                <span class="workflow-step-copy">
                                    <strong>1. Correct</strong>
                                    <span>Write the answer that should have been returned.</span>
                                </span>
                                <span class="workflow-step-icon">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                </span>
                            </div>
                            <div class="review-workflow-step @(CanPromoteToKnowledge(draft) ? "active" : null)">
                                <span class="workflow-step-marker"></span>
                                <span class="workflow-step-copy">
                                    <strong>2. Classify</strong>
                                    <span>Approved + category turns this into training data.</span>
                                </span>
                                <span class="workflow-step-icon">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                                        <path d="M14 2v6h6" />
                                        <path d="M9 15h6" />
                                        <path d="M9 11h2" />
                                    </svg>
                                </span>
                            </div>
                            <div class="review-workflow-step @(draft.PromoteToKnowledge ? "active" : null)">
                                <span class="workflow-step-marker"></span>
                                <span class="workflow-step-copy">
                                    <strong>3. Reuse</strong>
                                    <span>Publish as knowledge so future matches answer faster.</span>
                                </span>
                                <span class="workflow-step-icon">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                        <path d="M4 4v15.5" />
                                        <path d="M20 22V6a2 2 0 0 0-2-2H6.5A2.5 2.5 0 0 0 4 6.5" />
                                    </svg>
                                </span>
                            </div>
                        </div>

                        <div class="backoffice-grid report-review-form-grid">
                            <label>
                                <span title="The cleaned or corrected user question you want to keep as the reviewed version.">User prompt</span>
                                <textarea class="text-input backoffice-textarea compact-textarea" rows="3" @bind="draft.ValidatedQuestion"></textarea>
                            </label>
                            <label>
                                <span title="The corrected answer that you consider acceptable for this report.">Validated response</span>
                                <textarea class="text-input backoffice-textarea compact-textarea" rows="3" @bind="draft.ValidatedResponse"></textarea>
                            </label>
                            <label>
                                <span title="Approved means this corrected response is trusted and can become ML training data.">Review status</span>
                                <select class="text-input"
                                        value="@draft.ReviewStatus"
                                        @onchange="args => OnReviewStatusChanged(draft, args.Value?.ToString())">
                                    @foreach (var status in ReviewStatusOptions)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span title="This is the issue label used for future quality analysis and ML training examples.">Category</span>
                                <select class="text-input" @bind="draft.ReviewCategory">
                                    @foreach (var category in ReviewCategoryOptions)
                                    {
                                        <option value="@category">@((string.IsNullOrWhiteSpace(category) ? "None" : category))</option>
                                    }
                                </select>
                            </label>
                            <label class="backoffice-wide">
                                <span title="Optional notes for why the answer was wrong or how it was fixed.">Review notes</span>
                                <textarea class="text-input backoffice-textarea notes-textarea" rows="3" @bind="draft.ReviewNotes"></textarea>
                            </label>
                        </div>
                        <div class="backoffice-inline-options">
                            <label title="Create a reusable knowledge entry from this reviewed fix.">
                                <input type="checkbox"
                                       checked="@draft.PromoteToKnowledge"
                                       disabled="@(!CanPromoteToKnowledge(draft))"
                                       @onchange="args => OnPromoteToKnowledgeChanged(draft, args.Value)" />
                                Promote to knowledge
                            </label>
                            <label title="If promoted, make the new knowledge live right away.">
                                <input type="checkbox"
                                       checked="@draft.PublishKnowledge"
                                       disabled="@(!CanPublishKnowledge(draft))"
                               @onchange="args => OnPublishKnowledgeChanged(draft, args.Value)" />
                                Publish immediately
                            </label>
                        </div>
                        @if (draft.PromoteToKnowledge)
                        {
                            <div class="backoffice-grid report-review-form-grid promoted-knowledge-grid">
                                <label>
                                    <span title="Choose what kind of reusable knowledge this review should become.">Entry type</span>
                                    <select class="text-input" @bind="draft.KnowledgeEntryType">
                                        <option>QuickAnswer</option>
                                        <option>Topic</option>
                                        <option>Reference</option>
                                    </select>
                                </label>
                                <label>
                                    <span title="Logical group or source bucket for this knowledge entry.">Source name</span>
                                    <input class="text-input" @bind="draft.KnowledgeSourceName" />
                                </label>
                                <label class="backoffice-wide">
                                    <span title="Admin-facing title for the promoted knowledge entry.">Knowledge title</span>
                                    <input class="text-input" @bind="draft.KnowledgeTitle" />
                                </label>
                            </div>
                        }
                    </div>
                    <div class="backoffice-modal-actions review-modal-footer">
                        <div class="review-ready-note">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 16v-4" />
                                <path d="M12 8h.01" />
                            </svg>
                            Training-ready rule: set status to Approved, choose a category, and keep a validated response.
                        </div>
                        <button type="button" class="ghost-button icon-label-button" @onclick="CloseReportModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                            Cancel
                        </button>
                        <button type="button" class="primary-action slim icon-label-button" @onclick="SaveSelectedReportReviewAsync" disabled="@isBusy">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                            Save review
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (ShowUserModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="CloseUserModal">
                <div class="backoffice-modal admin-management-modal create-user-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Administration</div>
                            <h2>@(EditingUserId is null ? "Create User" : "Manage User")</h2>
                            <p>Assign roles, control access, and manage who can review data or administer the app.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close user form" @onclick="CloseUserModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="create-user-modal-body">
                        <section class="create-user-panel">
                            <h3>Account Details</h3>
                            <div class="backoffice-grid">
                                <label>
                                    <span>Username</span>
                                    <input class="text-input" @bind="UserModalDraft.Username" disabled="@(EditingUserId is not null)" />
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input class="text-input" @bind="UserModalDraft.Email" />
                                </label>
                                @if (EditingUserId is null)
                                {
                                    <label class="backoffice-wide">
                                        <span>Password</span>
                                        <input class="text-input" type="password" @bind="UserModalDraft.Password" />
                                    </label>
                                }
                            </div>
                        </section>

                        <section class="create-user-panel">
                            <h3>Access Settings</h3>
                            <div class="user-access-options">
                                <label><input type="checkbox" @bind="UserModalDraft.IsConfirmed" /> Confirmed</label>
                                <label><input type="checkbox" @bind="UserModalDraft.IsDisabled" /> Disabled</label>
                                @if (EditingUserId is not null)
                                {
                                    <span>@(SelectedUser?.TwoFactorEnabled == true ? "2FA is enabled for this user." : "2FA is not enabled for this user.")</span>
                                }
                            </div>
                        </section>

                        <section class="create-user-panel create-user-roles-panel">
                            <h3>Roles</h3>
                            <div class="user-role-options">
                                @foreach (var role in BackofficeRoleOptions)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@UserHasRole(UserModalDraft, role)"
                                               @onchange="args => OnUserRoleChanged(role, args.Value)" />
                                        @role
                                    </label>
                                }
                            </div>
                        </section>
                    </div>

                    <div class="backoffice-modal-actions">
                        <button type="button" class="ghost-button" @onclick="CloseUserModal">Cancel</button>
                        <button type="button" class="primary-action slim" @onclick="SaveUserModalAsync" disabled="@isBusy">
                            @(EditingUserId is null ? "Create user" : "Save user")
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (ShowFaqModal)
        {
            <div class="backoffice-modal-backdrop" role="presentation" @onclick="CloseFaqModal">
                <section class="backoffice-modal admin-management-modal faq-modal backoffice-faq-modal" role="dialog" aria-modal="true" aria-labelledby="backoffice-faq-modal-title" @onclick:stopPropagation="true">
                    <header class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Knowledge Base</div>
                            <h2 id="backoffice-faq-modal-title">Frequently Asked Questions</h2>
                            <p>Browse common setup, authentication, gateway, Docker, EF Core, and troubleshooting answers.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close FAQ dialog" @onclick="CloseFaqModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </header>

                    <div class="faq-modal-body">
                        <div class="faq-modal-summary">
                            <div>
                                <strong>@FilteredFaqItems.Count questions</strong>
                                <span>Showing @FaqPageStart-@FaqPageEnd</span>
                            </div>
                            <div class="faq-filter-wrap">
                                <button type="button"
                                        class="ghost-button faq-filter-button @(isFaqFilterOpen || HasFaqFilter ? "active" : null)"
                                        aria-expanded="@isFaqFilterOpen"
                                        @onclick="ToggleFaqFilter">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 5h18" />
                                        <path d="M6 12h12" />
                                        <path d="M10 19h4" />
                                    </svg>
                                    <span>Filter</span>
                                </button>

                                @if (isFaqFilterOpen)
                                {
                                    <div class="faq-filter-popover">
                                        <label for="backoffice-faq-filter-input">Search questions</label>
                                        <input id="backoffice-faq-filter-input"
                                               class="text-input"
                                               placeholder="Type keyword..."
                                               value="@FaqSearchTerm"
                                               @oninput="OnFaqSearchChanged" />
                                        @if (HasFaqFilter)
                                        {
                                            <button type="button" class="ghost-button" @onclick="ClearFaqFilter">Clear filter</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <section class="faq-modal-list" aria-label="Frequently asked questions">
                            @if (FilteredFaqItems.Count == 0)
                            {
                                <div class="faq-modal-empty">
                                    <strong>No questions found</strong>
                                    <span>Try another keyword.</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var item in PagedFaqItems)
                                {
                                    <details class="faq-modal-item" open="@IsFaqItemExpanded(item)">
                                        <summary @onclick:preventDefault="true" @onclick="() => ToggleFaqItem(item)">
                                            <span>@item.Question</span>
                                            <small>@item.Category</small>
                                        </summary>
                                        <p>@item.Answer</p>
                                    </details>
                                }
                            }
                        </section>

                        @if (FaqTotalPages > 1)
                        {
                            <nav class="faq-modal-pagination" aria-label="FAQ pagination">
                                <button type="button" class="ghost-button" disabled="@(FaqSafeCurrentPage == 1)" @onclick="PreviousFaqPage">Previous</button>
                                <div class="faq-page-dots">
                                    @foreach (var pageNumber in VisibleFaqPages)
                                    {
                                        <button type="button"
                                                class="faq-page-number @(pageNumber == FaqSafeCurrentPage ? "active" : null)"
                                                @onclick="() => GoToFaqPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    }
                                </div>
                                <button type="button" class="ghost-button" disabled="@(FaqSafeCurrentPage == FaqTotalPages)" @onclick="NextFaqPage">Next</button>
                            </nav>
                        }
                    </div>
                </section>
            </div>
        }
    }
</div>

