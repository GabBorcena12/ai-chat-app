        await RefreshPromptTemplatesCoreAsync(cancellationToken);
        PromptDrafts.Clear();
        SetStatus("Prompt templates refreshed.");
    });

    private Task LoadKnowledgeEntriesAsync() => RunBusyAsync(async cancellationToken =>
    {
        await RefreshKnowledgeEntriesCoreAsync(cancellationToken);
        KnowledgeDrafts.Clear();
        KnowledgePage = 1;
        SetStatus("Knowledge entries refreshed.");
    });

    private Task LoadUsersAsync() => RunBusyAsync(async cancellationToken =>
    {
        await RefreshUsersCoreAsync(cancellationToken);
        SetStatus("Users refreshed.");
    });

    private BackofficeReviewPayload GetReviewDraft(BackofficeReportViewModel report)
    {
        if (!ReviewDrafts.TryGetValue(report.Id, out var draft))
        {
            draft = new BackofficeReviewPayload
            {
                ReviewStatus = string.IsNullOrWhiteSpace(report.ReviewStatus) ? "Pending" : report.ReviewStatus,
                ReviewCategory = NormalizeReviewCategory(report.ReviewCategory),
                ReviewNotes = report.ReviewNotes,
                ValidatedQuestion = report.ValidatedQuestion ?? report.UserPrompt,
                ValidatedResponse = report.ValidatedResponse ?? report.AssistantResponse,
                KnowledgeEntryType = "QuickAnswer",
                KnowledgeSourceName = "QuickAnswers",
                KnowledgeTitle = report.UserPrompt
            };
            NormalizeReviewDraftState(draft);
            ReviewDrafts[report.Id] = draft;
        }

        return draft;
    }

    private SavePromptTemplatePayload GetPromptDraft(PromptTemplateViewModel template)
    {
        if (!PromptDrafts.TryGetValue(template.Id, out var draft))
        {
            draft = new SavePromptTemplatePayload
            {
                ProfileId = template.ProfileId,
                TemplateName = template.TemplateName,
                Content = template.Content,
                IsPublished = template.IsPublished
            };
            PromptDrafts[template.Id] = draft;
        }

        return draft;
    }

    private SaveKnowledgeEntryPayload GetKnowledgeDraft(KnowledgeEntryViewModel entry)
    {
        if (!KnowledgeDrafts.TryGetValue(entry.Id, out var draft))
        {
            draft = new SaveKnowledgeEntryPayload
            {
                ProfileId = entry.ProfileId,
                EntryType = entry.EntryType,
                SourceName = entry.SourceName,
                Title = entry.Title,
                Summary = entry.Summary,
                Content = DecodeKnowledgeContent(entry),
                Aliases = DeserializeOptionalList(entry.AliasesJson),
                Keywords = DeserializeOptionalList(entry.KeywordsJson),
                IsPublished = entry.IsPublished,
                SortOrder = entry.SortOrder
            };
            KnowledgeDrafts[entry.Id] = draft;
        }

        return draft;
    }

    private Task SaveReviewAsync(BackofficeReportViewModel report, BackofficeReviewPayload draft) => RunBusyAsync(async cancellationToken =>
    {
        if (draft.PromoteToKnowledge && string.Equals(draft.KnowledgeEntryType, "Topic", StringComparison.OrdinalIgnoreCase))
        {
            draft.ContextLines = SplitLines(draft.ValidatedResponse);
        }

        if (draft.PromoteToKnowledge && string.Equals(draft.KnowledgeEntryType, "QuickAnswer", StringComparison.OrdinalIgnoreCase))
        {
            draft.Aliases = SplitCsv(draft.ValidatedQuestion);
        }

        var successMessage = await GatewayClient.ReviewReportedResponseAsync(token!, report.Id, draft, cancellationToken);
        await RefreshReportsCoreAsync(cancellationToken);
        await RefreshKnowledgeEntriesCoreAsync(cancellationToken);
        CloseReportModal();
        SetStatus(successMessage);
        await ShowCompletionNotificationAsync(successMessage);
    });

    private Task SavePromptTemplateAsync(PromptTemplateViewModel template, SavePromptTemplatePayload draft) => RunBusyAsync(async cancellationToken =>
    {
        var successMessage = await GatewayClient.UpdatePromptTemplateAsync(token!, template.Id, draft, cancellationToken);
        await RefreshPromptTemplatesCoreAsync(cancellationToken);
        SetStatus(successMessage);
        await ShowCompletionNotificationAsync(successMessage);
    });

