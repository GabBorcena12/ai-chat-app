                                            <strong>@entry.Title</strong>
                                        </div>
                                    </button>
                                }
                            </div>
                        }

                        @if (KnowledgeTotalPages > 1)
                        {
                            <div class="listing-modal-pagination">
                                <button type="button" class="ghost-button" disabled="@(KnowledgePage <= 1)" @onclick="PreviousKnowledgePage">Previous</button>
                                <span>Page @KnowledgePage of @KnowledgeTotalPages</span>
                                <button type="button" class="ghost-button" disabled="@(KnowledgePage >= KnowledgeTotalPages)" @onclick="NextKnowledgePage">Next</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (ShowUserManagementModal)
