        @if (ShowTrainingDataModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="CloseTrainingDataModal">
                <div class="backoffice-modal admin-management-modal ml-training-management-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Machine Learning</div>
                            <h2>Training Data</h2>
                            <p>Import reviewed notes, add validated examples, and approve training material for the reviewer.</p>
                        </div>
                        <div class="modal-header-actions">
                            <button type="button" class="ghost-button modal-refresh-button icon-label-button" @onclick="RefreshTrainingWorkspaceState" disabled="@isBusy">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                    <path d="M4 4v5h5" />
                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2" />
                                    <path d="M20 20v-5h-5" />
                                </svg>
                                Refresh
                            </button>
                            <button type="button" class="ghost-button modal-close-icon" aria-label="Close training data" @onclick="CloseTrainingDataModal">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M18 6 6 18" />
                                    <path d="m6 6 12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="ml-training-modal-body">
                        <section class="ml-training-form-grid">
                            <article class="backoffice-card ml-training-upload-card">
                                <div>
                                    <h3>Import text notes</h3>
                                    <p>Upload `.txt` notes for draft reviewer examples. Validated Backoffice reports should remain the main training source.</p>
                                </div>
                                <div class="ml-training-upload-zone">
                                    <div class="ml-training-upload-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M12 16V4" />
                                            <path d="m7 9 5-5 5 5" />
                                            <path d="M20 16.5v2A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5v-2" />
                                        </svg>
                                    </div>
                                    <div>
                                        <strong>Choose a training notes file</strong>
                                        <span>Plain text only. Imported notes become draft examples.</span>
                                    </div>
                                    <InputFile class="ml-training-file-input" OnChange="ImportTrainingTextFileAsync" accept=".txt,text/plain" />
                                </div>
                            </article>

                            <article class="backoffice-card ml-training-form-card">
                                <div>
                                    <h3>Add reviewed example</h3>
                                    <p>Create one manually reviewed training example.</p>
                                </div>
                                <div class="backoffice-grid">
                                    <label>
                                        <span>Reviewed question</span>
                                        <input class="text-input" @bind="manualTrainingQuestion" placeholder="Question reviewed by admin" />
                                    </label>
                                    <label>
                                        <span>Intent</span>
                                        <input class="text-input" @bind="manualTrainingIntent" placeholder="DocumentationQuestion" />
                                    </label>
                                    <label>
                                        <span>Issue type</span>
                                        <input class="text-input" @bind="manualTrainingIssueType" placeholder="Incomplete" />
                                    </label>
                                    <label>
                                        <span>Bad response</span>
                                        <textarea class="text-input" @bind="manualTrainingBadResponse" placeholder="Original weak response"></textarea>
                                    </label>
                                    <label class="span-full">
                                        <span>Corrected answer</span>
                                        <textarea class="text-input" @bind="manualTrainingExpectedAnswer" placeholder="Answer that should have been returned"></textarea>
                                    </label>
                                </div>
                                <div class="backoffice-modal-actions compact-actions">
                                    <button type="button" class="primary-action slim icon-label-button" @onclick="AddReviewedTrainingExample">
                                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 5v14" />
                                            <path d="M5 12h14" />
                                        </svg>
                                        Add example
                                    </button>
                                </div>
                            </article>
                        </section>

                        <section class="backoffice-card ml-training-list-card">
                            <div class="training-candidates-header">
                                <div>
                                    <h3>Training examples</h3>
                                    <p>@TrainingWorkspace.Examples.Count example@(TrainingWorkspace.Examples.Count == 1 ? string.Empty : "s") available, @TrainingApprovedCount approved.</p>
                                </div>
                                <button type="button" class="ghost-button ml-training-theme-button" @onclick="ApproveAllTrainingDrafts">Approve all drafts</button>
                            </div>
                            <div class="ml-training-list">
                                @foreach (var example in TrainingWorkspace.Examples.Take(8))
                                {
                                    <button type="button" class="compact-listing-card compact-listing-row-button ml-training-row" @onclick="() => ApproveTrainingExample(example.Id)">
                                        <div>
                                            <strong>@example.Question</strong>
                                            <small>@example.SourceType / @example.Intent / @example.IssueType</small>
                                        </div>
                                        <span class="candidate-status @(example.ApprovedForTraining ? "progress" : "pending")">@example.ReviewStatus</span>
                                    </button>
                                }
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        }

        @if (ShowTrainingJobsModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="CloseTrainingJobsModal">
                <div class="backoffice-modal admin-management-modal ml-training-management-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Machine Learning</div>
                            <h2>Training Jobs</h2>
                            <p>Build reviewer datasets from approved examples and run ML.NET training jobs.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close training jobs" @onclick="CloseTrainingJobsModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="ml-training-modal-body">
                        <section class="backoffice-card ml-training-job-controls">
                            <div>
                                <h3>Dataset and training trigger</h3>
                                <p>Build a dataset from approved examples, then train a reviewer model from the latest dataset.</p>
                            </div>
                            <div class="ml-training-job-actions">
                                <input class="text-input" @bind="trainingDatasetName" placeholder="Dataset name" />
                                <button type="button" class="ghost-button ml-training-theme-button" @onclick="BuildTrainingDataset">Build dataset</button>
                                <button type="button" class="primary-action slim ml-training-theme-button" @onclick="QueueTrainingJobAsync" disabled="@(latestTrainingDatasetId is null || isTrainingJobRunning)">
                                    @(isTrainingJobRunning ? "Training..." : "Train model")
                                </button>
                            </div>
                        </section>

                        <section class="backoffice-card ml-training-list-card">
                            <div class="training-candidates-header">
                                <div>
                                    <h3>Training job history</h3>
                                    <p>@TrainingWorkspace.Jobs.Count job@(TrainingWorkspace.Jobs.Count == 1 ? string.Empty : "s") queued.</p>
                                </div>
                            </div>
                            <div class="ml-training-list">
                                @foreach (var job in TrainingWorkspace.Jobs.Take(8))
                                {
                                    <article class="compact-listing-card ml-training-job-row">
                                        <div>
                                            <strong>Training Job #@job.Id</strong>
                                            <small>Dataset #@job.DatasetId / @job.Status / @job.QueuedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small>
                                        </div>
                                        <span>Accuracy: @(job.Accuracy?.ToString("P1") ?? "-") / F1: @(job.F1Score?.ToString("P1") ?? "-")</span>
                                    </article>
                                }
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        }

        @if (ShowModelRegistryModal)
        {
