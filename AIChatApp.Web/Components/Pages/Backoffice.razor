                                            <span class="filter-input-shell">
                                                <input class="text-input"
                                                       title="Search by title, source, type, summary, or content."
                                                       placeholder="Search knowledge..."
                                                       value="@KnowledgeSearchTerm"
                                                       @oninput="OnKnowledgeSearchChanged" />
                                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                    <circle cx="11" cy="11" r="7" />
                                                    <path d="m21 21-4.3-4.3" />
                                                </svg>
                                            </span>
                                        </label>
                                        <label class="filter-field">
                                            <span>Type</span>
                                            <select class="text-input"
                                                    value="@KnowledgeTypeFilter"
                                                    @onchange="OnKnowledgeTypeFilterChanged"
                                                    title="Limit the list to one knowledge entry type.">
                                                <option value="">All types</option>
                                                <option value="QuickAnswer">QuickAnswer</option>
                                                <option value="Topic">Topic</option>
                                                <option value="Reference">Reference</option>
                                            </select>
                                        </label>
                                        <label class="filter-field">
                                            <span>Status</span>
                                            <select class="text-input"
                                                    value="@KnowledgeStatusFilter"
                                                    @onchange="OnKnowledgeStatusFilterChanged"
                                                    title="Limit the list by publish status.">
                                                @foreach (var option in KnowledgeStatusFilterOptions)
                                                {
                                                    <option value="@option.Value">@option.Label</option>
                                                }
                                            </select>
                                        </label>
                                        <label class="filter-field">
                                            <span>Updated</span>
                                            <select class="text-input"
                                                    value="@KnowledgeUpdatedFilter"
                                                    @onchange="OnKnowledgeUpdatedFilterChanged"
                                                    title="Limit the list by last updated date.">
                                                @foreach (var option in KnowledgeUpdatedFilterOptions)
                                                {
                                                    <option value="@option.Value">@option.Label</option>
                                                }
                                            </select>
                                        </label>
                                    </div>
                                    <div class="listing-filter-actions">
                                        <button type="button" class="ghost-button clear-filter-button icon-label-button" @onclick="ClearKnowledgeFilters" disabled="@(KnowledgeActiveFilterCount == 0)">
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                                <path d="M4 4v5h5" />
                                            </svg>
