    private string GetKnowledgeFilterSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(KnowledgeSearchTerm))
        {
            parts.Add($"Search: {KnowledgeSearchTerm.Trim()}");
        }

        parts.Add(string.IsNullOrWhiteSpace(KnowledgeTypeFilter) ? "All types" : KnowledgeTypeFilter);
        if (!string.IsNullOrWhiteSpace(KnowledgeStatusFilter))
        {
            parts.Add(KnowledgeStatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(KnowledgeUpdatedFilter))
        {
            var selected = KnowledgeUpdatedFilterOptions.FirstOrDefault(option => string.Equals(option.Value, KnowledgeUpdatedFilter, StringComparison.Ordinal));
            parts.Add(string.IsNullOrWhiteSpace(selected.Label) ? "Any time" : selected.Label);
        }

        return string.Join(" / ", parts);
    }

