                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Machine Learning</div>
                            <h2>Model Registry</h2>
                            <p>Review candidate reviewer models and publish the version used by the API quality gate.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close model registry" @onclick="CloseModelRegistryModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="ml-training-modal-body">
                        <section class="backoffice-card ml-training-list-card">
                            <div class="training-candidates-header">
                                <div>
                                    <h3>Reviewer models</h3>
