    }

    private void ApproveAllTrainingDrafts()
    {
        foreach (var example in TrainingWorkspace.Examples.Where(example => !example.ApprovedForTraining))
        {
            TrainingWorkspace.ApproveExample(example.Id, CurrentUsernameOrFallback);
        }

        SetStatus("All visible drafts approved.");
    }

    private void BuildTrainingDataset()
    {
        var dataset = TrainingWorkspace.BuildDataset(trainingDatasetName);
        latestTrainingDatasetId = dataset.Id;
        SetStatus($"Dataset {dataset.Name} v{dataset.Version} built with {dataset.ExampleCount} approved example(s).");
    }

    private async Task QueueTrainingJobAsync()
    {
        if (latestTrainingDatasetId is null)
        {
            SetStatus("Build a dataset before training.", isError: true);
            return;
        }

        try
        {
            isTrainingJobRunning = true;
            await TrainingWorkspace.QueueAndRunTrainingAsync(latestTrainingDatasetId.Value, CurrentUsernameOrFallback, CancellationToken.None);
            SetStatus("Training completed and model version registered.");
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            isTrainingJobRunning = false;
        }
    }

    private void PublishTrainingModel(int modelId)
    {
        try
