    private Task SaveKnowledgeModalAsync() => RunBusyAsync(async cancellationToken =>
    {
        NormalizeKnowledgeDraft(KnowledgeModalDraft);

        string successMessage;
        if (EditingKnowledgeId.HasValue)
        {
            successMessage = await GatewayClient.UpdateKnowledgeEntryAsync(token!, EditingKnowledgeId.Value, KnowledgeModalDraft, cancellationToken);
        }
        else
        {
            successMessage = await GatewayClient.CreateKnowledgeEntryAsync(token!, KnowledgeModalDraft, cancellationToken);
        }

        CloseKnowledgeModal();
        await RefreshKnowledgeEntriesCoreAsync(cancellationToken);
        SetStatus(successMessage);
        await ShowCompletionNotificationAsync(successMessage);
    });

    private Task SaveSelectedReportReviewAsync()
    {
        if (SelectedReport is null)
        {
            return Task.CompletedTask;
        }

        return SaveReviewAsync(SelectedReport, GetReviewDraft(SelectedReport));
    }

    private Task SaveUserModalAsync() => RunBusyAsync(async cancellationToken =>
    {
        var normalizedDraft = NormalizeUserDraft(UserModalDraft);
        string successMessage;

        if (string.IsNullOrWhiteSpace(EditingUserId))
        {
            successMessage = await GatewayClient.CreateBackofficeUserAsync(token!, normalizedDraft, cancellationToken);
        }
        else
        {
            successMessage = await GatewayClient.UpdateBackofficeUserAsync(token!, EditingUserId, normalizedDraft, cancellationToken);
        }

        CloseUserModal();
        await RefreshUsersCoreAsync(cancellationToken);
        SetStatus(successMessage);
        await ShowCompletionNotificationAsync(successMessage);
    });

    private async Task RunBusyAsync(Func<CancellationToken, Task> action)
    {
        if (!IsAuthenticated)
        {
            SetStatus("Sign in first to view or change anything in the backoffice.", isError: true);
            return;
        }

        isBusy = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
            await action(cts.Token);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshReportsCoreAsync(CancellationToken cancellationToken, string? status = null)
    {
        Reports = await GatewayClient.GetReportedResponsesAsync(token!, status, cancellationToken);
        if (SelectedReportId.HasValue && Reports.All(report => report.Id != SelectedReportId.Value))
        {
            CloseReportModal();
        }
    }

    private bool MatchesReportStatusFilter(BackofficeReportViewModel report)
    {
        if (string.IsNullOrWhiteSpace(ReportStatusFilter))
        {
            return true;
        }

        return string.Equals(GetReportStatusLabel(report), ReportStatusFilter, StringComparison.OrdinalIgnoreCase);
    }

    private async Task RefreshPromptTemplatesCoreAsync(CancellationToken cancellationToken)
        => PromptTemplates = await GatewayClient.GetPromptTemplatesAsync(token!, "Documentation", cancellationToken);

    private async Task RefreshKnowledgeEntriesCoreAsync(CancellationToken cancellationToken)
        => KnowledgeEntries = await GatewayClient.GetKnowledgeEntriesAsync(token!, "Documentation", null, cancellationToken);

    private async Task RefreshUsersCoreAsync(CancellationToken cancellationToken)
    {
        Users = await GatewayClient.GetBackofficeUsersAsync(token!, cancellationToken);
        if (!string.IsNullOrWhiteSpace(EditingUserId) && Users.All(user => !string.Equals(user.Id, EditingUserId, StringComparison.Ordinal)))
        {
            CloseUserModal();
        }
    }

    private void SetStatus(string message, bool isError = false)
    {
        StatusMessage = message;
        StatusIsError = isError;
    }

    private static void NormalizeKnowledgeDraft(SaveKnowledgeEntryPayload draft)
    {
        draft.Aliases = draft.EntryType == "QuickAnswer" ? NormalizeList(draft.Aliases ?? []) : null;
        draft.Keywords = draft.EntryType == "Topic" ? NormalizeList(draft.Keywords ?? []) : null;
        draft.Content = string.Join(Environment.NewLine, SplitLines(draft.Content));
    }

    private static string DecodeKnowledgeContent(KnowledgeEntryViewModel entry)
    {
        if (!string.Equals(entry.EntryType, "Topic", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(entry.Content))
        {
            return entry.Content ?? string.Empty;
        }

        try
        {
            var lines = JsonSerializer.Deserialize<List<string>>(entry.Content) ?? [];
            return string.Join(Environment.NewLine, lines);
        }
        catch (JsonException)
        {
            return entry.Content ?? string.Empty;
        }
    }

    private static List<string> DeserializeOptionalList(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return [];
        }

        try
        {
            return JsonSerializer.Deserialize<List<string>>(json) ?? [];
        }
        catch (JsonException)
        {
            return SplitCsv(json);
        }
    }

    private static List<string> SplitCsv(string? raw)
        => NormalizeList((raw ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private static List<string> SplitLines(string? raw)
        => NormalizeList((raw ?? string.Empty).Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private static List<string> NormalizeList(IEnumerable<string> values)
        => values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void OnReviewStatusChanged(BackofficeReviewPayload draft, string? status)
    {
        draft.ReviewStatus = string.IsNullOrWhiteSpace(status) ? "Pending" : status;
        NormalizeReviewDraftState(draft);
    }

    private void OnPromoteToKnowledgeChanged(BackofficeReviewPayload draft, object? value)
    {
        draft.PromoteToKnowledge = CanPromoteToKnowledge(draft) && IsChecked(value);
        NormalizeReviewDraftState(draft);
    }

    private void OnPublishKnowledgeChanged(BackofficeReviewPayload draft, object? value)
    {
        draft.PublishKnowledge = CanPublishKnowledge(draft) && IsChecked(value);
        NormalizeReviewDraftState(draft);
    }

    private static bool CanPromoteToKnowledge(BackofficeReviewPayload draft)
        => string.Equals(draft.ReviewStatus, "Reviewed", StringComparison.OrdinalIgnoreCase)
           || string.Equals(draft.ReviewStatus, "Approved", StringComparison.OrdinalIgnoreCase);

    private static bool CanPublishKnowledge(BackofficeReviewPayload draft)
        => draft.PromoteToKnowledge
           && string.Equals(draft.ReviewStatus, "Approved", StringComparison.OrdinalIgnoreCase);

    private static void NormalizeReviewDraftState(BackofficeReviewPayload draft)
    {
        if (!CanPromoteToKnowledge(draft))
        {
            draft.PromoteToKnowledge = false;
        }

        if (!CanPublishKnowledge(draft))
        {
            draft.PublishKnowledge = false;
        }
    }

    private static bool IsChecked(object? value)
        => value switch
        {
            bool boolValue => boolValue,
            string stringValue when bool.TryParse(stringValue, out var parsed) => parsed,
            _ => false
        };

    private bool MatchesKnowledgeFilter(KnowledgeEntryViewModel entry)
    {
        if (!string.IsNullOrWhiteSpace(KnowledgeTypeFilter)
            && !string.Equals(entry.EntryType, KnowledgeTypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(KnowledgeSearchTerm))
        {
            return true;
        }

        var term = KnowledgeSearchTerm.Trim();
        return Contains(term, entry.Title)
               || Contains(term, entry.SourceName)
               || Contains(term, entry.EntryType)
               || Contains(term, DecodeKnowledgeContent(entry))
               || Contains(term, entry.Summary);
    }

    private static bool Contains(string term, string? value)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private bool MatchesUserFilter(BackofficeUserViewModel user)
    {
        if (string.IsNullOrWhiteSpace(UserSearchTerm))
        {
            return true;
        }

        var term = UserSearchTerm.Trim();
        return Contains(term, user.Username)
               || Contains(term, user.Email)
               || user.Roles.Any(role => Contains(term, role));
    }

    private static string NormalizeReviewCategory(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            return string.Empty;
        }

        return ReviewCategoryOptions.FirstOrDefault(option => string.Equals(option, category, StringComparison.OrdinalIgnoreCase))
               ?? "Other";
    }

    private static string FormatKnowledgeTimestamp(KnowledgeEntryViewModel entry)
    {
        var created = entry.CreatedAt == default ? entry.UpdatedAt : entry.CreatedAt;
        var updated = entry.UpdatedAt == default ? created : entry.UpdatedAt;
        var effective = updated >= created ? updated : created;
        return effective.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static string GetKnowledgePreview(KnowledgeEntryViewModel entry)
    {
        var content = DecodeKnowledgeContent(entry);
        if (string.IsNullOrWhiteSpace(content))
        {
            return "No content saved yet.";
        }

        var compact = content.Replace("\r\n", " ").Replace('\n', ' ').Trim();
        return compact.Length <= 180 ? compact : $"{compact[..180]}...";
    }

    private static string GetReportTitle(BackofficeReportViewModel report)
    {
        var source = string.IsNullOrWhiteSpace(report.ValidatedQuestion) ? report.UserPrompt : report.ValidatedQuestion;
        if (string.IsNullOrWhiteSpace(source))
        {
            return $"Report #{report.Id}";
        }

        var compact = source.Replace("\r\n", " ").Replace('\n', ' ').Trim();
        return compact.Length <= 72 ? compact : $"{compact[..72]}...";
    }

    private static string GetReportPreview(BackofficeReportViewModel report)
    {
        var answer = string.IsNullOrWhiteSpace(report.ValidatedResponse) ? report.AssistantResponse : report.ValidatedResponse;
        if (string.IsNullOrWhiteSpace(answer))
        {
            return "No response saved yet.";
        }

        var compact = answer.Replace("\r\n", " ").Replace('\n', ' ').Trim();
        return compact.Length <= 180 ? compact : $"{compact[..180]}...";
    }

    private static string GetReportStatusLabel(BackofficeReportViewModel report)
        => string.IsNullOrWhiteSpace(report.ReviewStatus) ? "Pending" : report.ReviewStatus;

    private static string FormatReportTimestamp(BackofficeReportViewModel report)
        => report.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt");

    private Task ShowCompletionNotificationAsync(string message)
    {
        CompletionNotice = message;
        _ = NotifyCompletionAsync(message);
        return InvokeAsync(StateHasChanged);
    }

    private async Task NotifyCompletionAsync(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("aiChatUi.notifyCompletion", message);
        }
        catch
        {
        }

        await Task.Delay(2600);
        if (CompletionNotice == message)
        {
            CompletionNotice = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private enum BackofficeSection
    {
        Reports,
        Prompts,
        Knowledge,
        Profile,
        Users
    }

    private static SaveBackofficeUserPayload CreateDefaultUserDraft()
        => new()
        {
            Roles = ["AppUser"],
            IsConfirmed = true
        };

    private static string NormalizeProfileText(string value, int maxLength)
    {
        var normalized = System.Text.RegularExpressions.Regex.Replace(value.Trim(), @"\s+", " ");
        return normalized.Length <= maxLength ? normalized : normalized[..maxLength];
    }

    private static string BuildDefaultAvatarLabel(string displayName)
    {
        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
            .ToArray();

        return parts.Length == 0 ? "You" : new string(parts);
    }

    private static SaveBackofficeUserPayload NormalizeUserDraft(SaveBackofficeUserPayload draft)
        => new()
        {
            Username = draft.Username.Trim(),
            Email = draft.Email.Trim(),
            Password = draft.Password,
            Roles = NormalizeList(draft.Roles).ToList(),
            IsConfirmed = draft.IsConfirmed,
            IsDisabled = draft.IsDisabled
        };

    private static bool UserHasRole(SaveBackofficeUserPayload draft, string role)
        => draft.Roles.Any(existingRole => string.Equals(existingRole, role, StringComparison.OrdinalIgnoreCase));

    private void OnUserRoleChanged(string role, object? value)
    {
        if (IsChecked(value))
        {
            if (!UserHasRole(UserModalDraft, role))
            {
                UserModalDraft.Roles.Add(role);
            }
        }
        else
        {
            UserModalDraft.Roles = UserModalDraft.Roles
                .Where(existingRole => !string.Equals(existingRole, role, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (UserModalDraft.Roles.Count == 0)
        {
            UserModalDraft.Roles.Add("AppUser");
        }
    }
}
