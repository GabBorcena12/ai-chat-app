@page "/backoffice"
@rendermode InteractiveServer
@using AIChatApp.Web.Config
@using System.Text.Json
@inject AIChatApp.Web.Services.AIChatGatewayClient GatewayClient
@inject AIChatApp.Web.Services.BrowserStorageService BrowserStorage
@inject AIChatApp.Web.Services.FaqContentService FaqContent
@inject TrainingWorkspaceService TrainingWorkspace
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Backoffice</PageTitle>

<div class="backoffice-page backoffice-chat-theme @(isBackofficeSidebarOpen ? "sidebar-open" : null) @(isBackofficeSidebarHidden ? "sidebar-nav-hidden" : null)">
    @if (!string.IsNullOrWhiteSpace(CompletionNotice))
    {
        <div class="completion-toast" role="status" aria-live="polite">@CompletionNotice</div>
    }

    @if (!initialized)
    {
        <section class="backoffice-loading-shell" role="status" aria-live="polite">
            <div class="backoffice-loading-card">
                <div class="brand-symbol" aria-hidden="true">
                    <img src="chat-assistant-logo.png" alt="" />
                </div>
                <div>
                    <div class="eyebrow">Admin Workspace</div>
                    <h1>Loading Backoffice</h1>
                    <p>Preparing validation tools, reports, prompts, and knowledge controls.</p>
                </div>
                <span class="backoffice-loading-spinner" aria-hidden="true"></span>
            </div>
        </section>
    }
    else if (!IsAuthenticated)
    {
        <p class="status-note">Sign in first to open the backoffice.</p>
    }
    else
    {
        <div class="backoffice-layout">
            <aside class="backoffice-sidebar">
                <div class="brand-card backoffice-brand-card">
                    <div class="brand-symbol" aria-hidden="true">
                        <img src="chat-assistant-logo.png" alt="" />
                    </div>
                    <div>
                        <div class="eyebrow">Project Knowledge Base</div>
                        <h2>Chat Assistant</h2>
                    </div>
                    <button type="button" class="ghost-button sidebar-nav-toggle-button nav-image-button" aria-label="Hide side navigation" title="Hide side navigation" @onclick="HideBackofficeSidebar">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="16" rx="3" />
                            <path d="M9 4v16" />
                            <path d="m15 9-3 3 3 3" />
                        </svg>
                    </button>
                </div>

                <section class="backoffice-nav-group collapsible-sidebar-section @(workspacesNavOpen ? null : "collapsed")">
                    <button type="button"
                            class="backoffice-nav-heading"
                            aria-expanded="@workspacesNavOpen"
                            @onclick="() => ToggleBackofficeNavGroup(BackofficeNavGroup.Workspaces)">
                        <span>Workspaces</span>
                        <small>Move between app areas</small>
                        <strong class="section-toggle-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </strong>
                    </button>
                    @if (workspacesNavOpen)
                    {
                        <button type="button" class="backoffice-nav-button app-chat" @onclick='() => Navigation.NavigateTo("/chat")'>
                            <span>Chat</span>
                            <small>Main assistant</small>
                        </button>
                        <button type="button" class="backoffice-nav-button app-backoffice active" @onclick='() => Navigation.NavigateTo("/backoffice")'>
                            <span>Backoffice</span>
                            <small>Validation workspace</small>
                        </button>
                        <button type="button" class="backoffice-nav-button app-faq @(ShowFaqModal ? "active" : null)" @onclick="OpenFaqModalAsync">
                            <span>FAQs</span>
                            <small>User guide</small>
                        </button>
                    }
                </section>

                <section class="backoffice-nav-group collapsible-sidebar-section @(validationNavOpen ? null : "collapsed")">
                    <button type="button"
                            class="backoffice-nav-heading"
                            aria-expanded="@validationNavOpen"
                            @onclick="() => ToggleBackofficeNavGroup(BackofficeNavGroup.Validation)">
                        <span>Validation</span>
                        <small>Improve answer quality</small>
                        <strong class="section-toggle-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </strong>
                    </button>
                    @if (validationNavOpen)
                    {
                        <button type="button"
                                class="backoffice-nav-button @(ActiveSection == BackofficeSection.Workflow ? "active" : null)"
                                @onclick="() => SetSection(BackofficeSection.Workflow)">
                            <span>Workflow</span>
                            <small>See the full improvement loop</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ActiveSection == BackofficeSection.Reports ? "active" : null)"
                                @onclick="OpenReportsManagementModalAsync">
                            <span>Reported Responses</span>
                            <small>Validate and promote reported answers</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ActiveSection == BackofficeSection.Prompts ? "active" : null)"
                                @onclick="OpenPromptsManagementModalAsync">
                            <span>Prompt Templates</span>
                            <small>Control assistant behavior</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ActiveSection == BackofficeSection.Knowledge ? "active" : null)"
                                @onclick="OpenKnowledgeManagementModalAsync">
                            <span>Knowledge Entries</span>
                            <small>Manage quick answers and references</small>
                        </button>
                    }
                </section>

                <section class="backoffice-nav-group collapsible-sidebar-section @(machineLearningNavOpen ? null : "collapsed")">
                    <button type="button"
                            class="backoffice-nav-heading"
                            aria-expanded="@machineLearningNavOpen"
                            @onclick="() => ToggleBackofficeNavGroup(BackofficeNavGroup.MachineLearning)">
                        <span>Machine Learning</span>
                        <small>Reviewer training and publishing</small>
                        <strong class="section-toggle-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </strong>
                    </button>
                    @if (machineLearningNavOpen)
                    {
                        <button type="button"
                                class="backoffice-nav-button app-ml @(ActiveSection == BackofficeSection.MlTraining ? "active" : null)"
                                @onclick="() => SetSection(BackofficeSection.MlTraining)">
                            <span>ML Training</span>
                            <small>Build, train, and publish reviewer</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ShowTrainingDataModal ? "active" : null)"
                                @onclick="OpenTrainingDataModal">
                            <span>Training Data</span>
                            <small>Review examples and imports</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ShowTrainingJobsModal ? "active" : null)"
                                @onclick="OpenTrainingJobsModal">
                            <span>Training Jobs</span>
                            <small>Build datasets and run training</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ShowModelRegistryModal ? "active" : null)"
                                @onclick="OpenModelRegistryModal">
                            <span>Model Registry</span>
                            <small>Publish reviewer models</small>
                        </button>
                    }
                </section>

                <section class="backoffice-nav-group collapsible-sidebar-section @(administrationNavOpen ? null : "collapsed")">
                    <button type="button"
                            class="backoffice-nav-heading"
                            aria-expanded="@administrationNavOpen"
                            @onclick="() => ToggleBackofficeNavGroup(BackofficeNavGroup.Administration)">
                        <span>Administration</span>
                        <small>People and profile settings</small>
                        <strong class="section-toggle-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </strong>
                    </button>
                    @if (administrationNavOpen)
                    {
                        <button type="button"
                                class="backoffice-nav-button @(ShowProfileManagementModal ? "active" : null)"
                                @onclick="OpenProfileManagementModal">
                            <span>Profile Management</span>
                            <small>Change chat display name and avatar</small>
                        </button>
                        <button type="button"
                                class="backoffice-nav-button @(ShowUserManagementModal ? "active" : null)"
                                @onclick="OpenUserManagementModal">
                            <span>User Management</span>
                            <small>Create users and manage backoffice roles</small>
                        </button>
                    }
                </section>

                <button type="button"
                        class="ghost-button sidebar-logout-button backoffice-sidebar-logout-button"
                        @onclick="LogoutAsync">
                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 17 15 12l-5-5" />
                        <path d="M15 12H3" />
                        <path d="M21 19V5a2 2 0 0 0-2-2h-6" />
                    </svg>
                    <span>Logout</span>
                </button>
            </aside>

            <section class="backoffice-content">
                <header class="backoffice-header">
                    <button type="button"
                            class="ghost-button sidebar-toggle-button nav-image-button backoffice-sidebar-toggle"
                            aria-label="@(isBackofficeSidebarHidden ? "Show side navigation" : "Open side navigation")"
                            @onclick="ToggleBackofficeSidebar">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            @if (isBackofficeSidebarHidden)
                            {
                                <rect x="3" y="4" width="18" height="16" rx="3" />
                                <path d="M9 4v16" />
                                <path d="m12 9 3 3-3 3" />
                            }
                            else
                            {
                                <path d="M4 7h16" />
                                <path d="M4 12h16" />
                                <path d="M4 17h16" />
                            }
                        </svg>
                    </button>
                    <div class="backoffice-title-block">
                        <div class="eyebrow">Admin Workspace</div>
                        <h1>@ActiveSectionTitle</h1>
                    </div>
                </header>

                @if (StatusIsError && !string.IsNullOrWhiteSpace(StatusMessage))
                {
                    <p class="status-note @(StatusIsError ? "error" : "success")">@StatusMessage</p>
                }

                @if (ActiveSection == BackofficeSection.Workflow)
                {
                    <section class="backoffice-section workflow-dashboard-section">
                        <div class="workflow-dashboard-header">
                            <div>
                                <h2>Answer Improvement Workflow</h2>
                                <p>Follow this path to create AI-accurate, consistent, and high-quality answers.</p>
                            </div>
                            <div class="workflow-dashboard-actions">
                                <button type="button" class="ghost-button" @onclick="LoadAllAsync" disabled="@isBusy">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                        <path d="M4 4v5h5" />
                                        <path d="M4 13a8.1 8.1 0 0 0 15.5 2" />
                                        <path d="M20 20v-5h-5" />
                                    </svg>
                                    Refresh
                                </button>
                                <button type="button" class="ghost-button backoffice-external-link" @onclick="() => SetSection(BackofficeSection.MlTraining)">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="m8 5 11 7-11 7Z" />
                                    </svg>
                                    Open ML Training
                                </button>
                            </div>
                        </div>

                        <div class="workflow-metrics">
                            <article class="metric-blue">
                                <div>
                                    <strong>@WorkflowSummary.PendingReports</strong>
                                    <span>Needs review</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <rect x="8" y="4" width="8" height="4" rx="1" />
                                        <path d="M8 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-2" />
                                        <path d="M9 13h6" />
                                        <path d="M9 17h4" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 28%"></span></span>
                            </article>
                            <article class="metric-green">
                                <div>
                                    <strong>@WorkflowSummary.ApprovedReports</strong>
                                    <span>Approved fixes</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="m8.5 12.5 2.2 2.2 4.8-5.2" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 88%"></span></span>
                            </article>
                            <article class="metric-purple">
                                <div>
                                    <strong>@WorkflowSummary.TrainingCandidates</strong>
                                    <span>Training candidates</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <path d="M22 10 12 5 2 10l10 5 10-5Z" />
                                        <path d="M6 12.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-3.5" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 92%"></span></span>
                            </article>
                            <article class="metric-cyan">
                                <div>
                                    <strong>@WorkflowSummary.PublishedKnowledgeEntries</strong>
                                    <span>In knowledge</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                        <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 94%"></span></span>
                            </article>
                        </div>

                        <div class="workflow-controls-panel">
                            <div class="workflow-controls-header">
                                <div>
                                    <h3>Manual tests and publish controls</h3>
                                    <p>Run and review manual checks to maintain quality before publishing answers.</p>
                                </div>
                                <div class="workflow-stepper" aria-label="Reviewer publish path">
                                    <span class="active">1. Approved responses</span>
                                    <span>2. Evaluated</span>
                                    <span>3. Training passed</span>
                                    <span>4. In knowledge</span>
                                    <span>5. Build status</span>
                                    <span>6. Published</span>
                                </div>
                            </div>

                            <div class="workflow-control-grid">
                                <article class="workflow-card control-card green">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <rect x="5" y="5" width="14" height="14" rx="2" />
                                            <path d="m9 12 2 2 4-5" />
                                        </svg>
                                    </span>
                                    <h3>Import test answer</h3>
                                    <p>Import the latest export of reviewed answers. This keeps manual tests aligned with recent changes.</p>
                                    <button type="button" class="ghost-button" @onclick="OpenReportsManagementModalAsync">Open import</button>
                                </article>
                                <article class="workflow-card control-card green">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                            <path d="m9 12 2 2 4-5" />
                                        </svg>
                                    </span>
                                    <h3>Validate correction</h3>
                                    <p>Scan for format, content, and structure issues before evaluation. Only valid items move to Approved.</p>
                                    <button type="button" class="ghost-button" @onclick="OpenReportsManagementModalAsync">Open validation</button>
                                </article>
                                <article class="workflow-card control-card purple">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                                            <path d="M14 2v6h6" />
                                            <path d="M8 13h8" />
                                            <path d="M8 17h6" />
                                        </svg>
                                    </span>
                                    <h3>Publish knowledge</h3>
                                    <p>Approved answers are published to the knowledge base and become available for training.</p>
                                    <button type="button" class="ghost-button" @onclick="OpenKnowledgeManagementModalAsync">Open knowledge</button>
                                </article>
                                <article class="workflow-card control-card blue">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M4 19V9" />
                                            <path d="M10 19V5" />
                                            <path d="M16 19v-8" />
                                            <path d="M22 19H2" />
                                        </svg>
                                    </span>
                                    <h3>Build and train</h3>
                                    <p>Prepare data and models using the published content. Check build status and start training.</p>
                                    <div class="control-card-actions">
                                        <button type="button" class="ghost-button" @onclick="BuildReviewerDatasetAsync" disabled="@isBusy">Build dataset</button>
                                        <button type="button" class="ghost-button" @onclick="TrainReviewerAsync" disabled="@isBusy">Train model</button>
                                    </div>
                                </article>
                                <article class="workflow-card control-card cyan">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1-4.4-4.3 6.1-.9L12 3Z" />
                                        </svg>
                                    </span>
                                    <h3>Publish quality gate</h3>
                                    <p>Final quality review and approval. Only items that pass the gate are available in the NLU engine.</p>
                                    <button type="button" class="ghost-button" @onclick="PublishLatestReviewerAsync" disabled="@isBusy">Open quality gate</button>
                                </article>
                            </div>
                        </div>

                        <section class="training-candidates-panel">
                            <div class="training-candidates-header">
                                <div>
                                    <h2>Training Candidates</h2>
                                    <p>These come from approved reports with a validated answer and issue category.</p>
                                </div>
                            </div>

                            @if (TrainingCandidates.Count == 0)
                            {
                                <div class="candidate-checklist">
                                    <article>
                                        <span class="candidate-icon" aria-hidden="true">
                                            <svg class="action-icon" viewBox="0 0 24 24">
                                                <path d="M10 6H6v4" />
                                                <path d="m6 6 6 6" />
                                                <path d="M14 18h4v-4" />
                                                <path d="m18 18-6-6" />
                                            </svg>
                                        </span>
                                        <div>
                                            <strong>Ensure all concepts have documentation</strong>
                                            <p>Verify that every concept used in answers has a knowledge article.</p>
                                        </div>
                                        <span class="candidate-status progress">In progress</span>
                                    </article>
                                    <article>
                                        <span class="candidate-icon" aria-hidden="true">
                                            <svg class="action-icon" viewBox="0 0 24 24">
                                                <path d="M10 6H6v4" />
                                                <path d="m6 6 6 6" />
                                                <path d="M14 18h4v-4" />
                                                <path d="m18 18-6-6" />
                                            </svg>
                                        </span>
                                        <div>
                                            <strong>Question that are not matched are already in knowledge</strong>
                                            <p>Confirm unmatched questions are captured as knowledge articles or excluded from training.</p>
                                        </div>
                                        <span class="candidate-status pending">Pending</span>
                                    </article>
                                    <article>
                                        <span class="candidate-icon" aria-hidden="true">
                                            <svg class="action-icon" viewBox="0 0 24 24">
                                                <path d="M10 6H6v4" />
                                                <path d="m6 6 6 6" />
                                                <path d="M14 18h4v-4" />
                                                <path d="m18 18-6-6" />
                                            </svg>
                                        </span>
                                        <div>
                                            <strong>Correct answer AND order is correctly matched in NLU reference</strong>
                                            <p>Verify that the correct answer and order are matched in the NLU reference for each response.</p>
                                        </div>
                                        <span class="candidate-status review">In review</span>
                                    </article>
                                </div>
                            }
                            else
                            {
                                <div class="candidate-checklist">
                                @foreach (var candidate in TrainingCandidates.Take(8))
                                {
                                    <article>
                                        <span class="candidate-icon" aria-hidden="true">
                                            <svg class="action-icon" viewBox="0 0 24 24">
                                                <path d="M10 6H6v4" />
                                                <path d="m6 6 6 6" />
                                                <path d="M14 18h4v-4" />
                                                <path d="m18 18-6-6" />
                                            </svg>
                                        </span>
                                        <div>
                                            <strong>Report #@candidate.ReportId - @candidate.IssueType</strong>
                                            <p>@candidate.Question</p>
                                        </div>
                                        <span class="candidate-status @(candidate.IsPromotedToKnowledge ? "progress" : "pending")">
                                            @(candidate.IsPromotedToKnowledge ? "In knowledge" : "Pending")
                                        </span>
                                    </article>
                                }
                                </div>
                            }
                        </section>

                        <div class="workflow-important-note">
                            <div>
                                <span class="note-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M12 8h.01" />
                                        <path d="M11 12h1v4h1" />
                                    </svg>
                                </span>
                                <div>
                                    <strong>Important</strong>
                                    <p>The training process is sequential. Please complete each step in order to maintain data quality and accuracy.</p>
                                </div>
                            </div>
                            <button type="button" class="ghost-button backoffice-external-link" @onclick="OpenTrainingDataModal">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                    <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z" />
                                </svg>
                                View training data
                            </button>
                        </div>
                    </section>
                }
                else if (ActiveSection == BackofficeSection.MlTraining)
                {
                    <section class="backoffice-section workflow-dashboard-section ml-training-backoffice-section">
                        <div class="workflow-dashboard-header">
                            <div>
                                <h2>ML Training</h2>
                                <p>Train and publish the ML.NET reviewer that checks answer quality before responses become trusted knowledge.</p>
                            </div>
                            <div class="workflow-dashboard-actions">
                                <button type="button" class="ghost-button" @onclick="LoadAllAsync" disabled="@isBusy">
                                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                        <path d="M4 4v5h5" />
                                        <path d="M4 13a8.1 8.1 0 0 0 15.5 2" />
                                        <path d="M20 20v-5h-5" />
                                    </svg>
                                    Refresh
                                </button>
                            </div>
                        </div>

                        <div class="workflow-metrics ml-training-metrics">
                            <article class="metric-green">
                                <div>
                                    <strong>@ReviewerState.ApprovedExamples</strong>
                                    <span>Approved examples</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="9" />
                                        <path d="m8.5 12.5 2.2 2.2 4.8-5.2" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 76%"></span></span>
                            </article>
                            <article class="metric-blue">
                                <div>
                                    <strong>@ReviewerState.DatasetCount</strong>
                                    <span>Datasets</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <rect x="4" y="5" width="16" height="14" rx="2" />
                                        <path d="M8 9h8" />
                                        <path d="M8 13h8" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 42%"></span></span>
                            </article>
                            <article class="metric-purple">
                                <div>
                                    <strong>@ReviewerState.JobCount</strong>
                                    <span>Training jobs</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <path d="M4 19V9" />
                                        <path d="M10 19V5" />
                                        <path d="M16 19v-8" />
                                        <path d="M22 19H2" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 58%"></span></span>
                            </article>
                            <article class="metric-cyan">
                                <div>
                                    <strong>@ReviewerState.ModelCount</strong>
                                    <span>Reviewer models</span>
                                </div>
                                <div class="metric-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                        <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15Z" />
                                    </svg>
                                </div>
                                <span class="metric-progress"><span style="width: 68%"></span></span>
                            </article>
                        </div>

                        <div class="workflow-controls-panel ml-training-panel">
                            <div class="workflow-controls-header">
                                <div>
                                    <h3>Reviewer training controls</h3>
                                    <p>Build a dataset from approved corrections, train the ML.NET reviewer, then publish the latest model.</p>
                                </div>
                                <div class="workflow-stepper" aria-label="ML reviewer training path">
                                    <span class="active">1. Approved examples</span>
                                    <span>2. Build dataset</span>
                                    <span>3. Train model</span>
                                    <span>4. Publish reviewer</span>
                                </div>
                            </div>

                            <div class="workflow-control-grid">
                                <article class="workflow-card control-card green">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                                            <path d="m9 12 2 2 4-5" />
                                        </svg>
                                    </span>
                                    <h3>Review candidates</h3>
                                    <p>Start with reported answers that have a validated correction and issue category.</p>
                                    <button type="button" class="ghost-button" @onclick="OpenReportsManagementModalAsync">Open reported responses</button>
                                </article>
                                <article class="workflow-card control-card blue">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <rect x="4" y="5" width="16" height="14" rx="2" />
                                            <path d="M8 9h8" />
                                            <path d="M8 13h8" />
                                            <path d="M8 17h5" />
                                        </svg>
                                    </span>
                                    <h3>Build dataset</h3>
                                    <p>Create the training snapshot from approved examples before training a reviewer model.</p>
                                    <button type="button" class="ghost-button" @onclick="BuildReviewerDatasetAsync" disabled="@isBusy">Build dataset</button>
                                </article>
                                <article class="workflow-card control-card purple">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="M22 10 12 5 2 10l10 5 10-5Z" />
                                            <path d="M6 12.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-3.5" />
                                        </svg>
                                    </span>
                                    <h3>Train model</h3>
                                    <p>Run ML.NET training using the latest dataset and register the produced reviewer model.</p>
                                    <button type="button" class="ghost-button" @onclick="TrainReviewerAsync" disabled="@isBusy">Train model</button>
                                </article>
                                <article class="workflow-card control-card cyan">
                                    <span class="control-icon" aria-hidden="true">
                                        <svg class="action-icon" viewBox="0 0 24 24">
                                            <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.8 1-6.1-4.4-4.3 6.1-.9L12 3Z" />
                                        </svg>
                                    </span>
                                    <h3>Publish reviewer</h3>
                                    <p>Promote the latest trained model so the API can use it as the quality gate.</p>
                                    <button type="button" class="ghost-button" @onclick="PublishLatestReviewerAsync" disabled="@isBusy">Publish latest</button>
                                </article>
                            </div>
                        </div>

                        <section class="training-candidates-panel">
                            <div class="training-candidates-header">
                                <div>
                                    <h2>Training candidates</h2>
                                    <p>Approved reports that are ready to become reviewer training examples.</p>
                                </div>
                                <span class="candidate-status progress">@TrainingCandidates.Count candidate@(TrainingCandidates.Count == 1 ? string.Empty : "s")</span>
                            </div>

                            @if (TrainingCandidates.Count == 0)
                            {
                                <p class="backoffice-empty">No training candidates yet. Approve reported responses with a corrected answer and issue category first.</p>
                            }
                            else
                            {
                                <div class="candidate-checklist">
                                    @foreach (var candidate in TrainingCandidates.Take(6))
                                    {
                                        <article>
                                            <span class="candidate-icon" aria-hidden="true">
                                                <svg class="action-icon" viewBox="0 0 24 24">
                                                    <path d="M10 6H6v4" />
                                                    <path d="m6 6 6 6" />
                                                    <path d="M14 18h4v-4" />
                                                    <path d="m18 18-6-6" />
                                                </svg>
                                            </span>
                                            <div>
                                                <strong>Report #@candidate.ReportId - @candidate.IssueType</strong>
                                                <p>@candidate.Question</p>
                                            </div>
                                            <span class="candidate-status @(candidate.IsPromotedToKnowledge ? "progress" : "pending")">
                                                @(candidate.IsPromotedToKnowledge ? "In knowledge" : "Pending")
                                            </span>
                                        </article>
                                    }
                                </div>
                            }
                        </section>

                        <div class="workflow-important-note">
                            <div>
                                <span class="note-icon" aria-hidden="true">
                                    <svg class="action-icon" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M12 8h.01" />
                                        <path d="M11 12h1v4h1" />
                                    </svg>
                                </span>
                                <div>
                                    <strong>Published reviewer</strong>
                                    <p>@(string.IsNullOrWhiteSpace(ReviewerState.PublishedModelVersion) ? "No reviewer model is published yet." : $"Current published model: {ReviewerState.PublishedModelVersion}")</p>
                                </div>
                            </div>
                            <button type="button" class="ghost-button" @onclick="LoadAllAsync" disabled="@isBusy">Refresh state</button>
                        </div>
                    </section>
                }
                else if (ActiveSection == BackofficeSection.Reports)
                {
                    <section class="backoffice-section">
                        <div class="backoffice-section-header">
                            <div>
                                <h2>Reported Responses</h2>
                                <p>Validate reported chat answers and optionally promote them into published knowledge.</p>
                            </div>
                            <div class="backoffice-toolbar">
                                <button type="button"
                                        class="ghost-button backoffice-external-link"
                                        title="Open ML Training after reviewing reported responses."
                                        @onclick="() => SetSection(BackofficeSection.MlTraining)">
                                    Open ML Training
                                </button>
                                <button type="button" class="ghost-button" @onclick="LoadReportsAsync" disabled="@isBusy">Refresh</button>
                            </div>
                        </div>

                        <div class="backoffice-filters">
                            <select class="text-input" @bind="ReportStatusFilter" title="Limit the list to one report status.">
                                @foreach (var option in ReportStatusFilterOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>

                        @if (FilteredReports.Count == 0)
                        {
                            <p class="backoffice-empty">No reported responses found for this filter.</p>
                        }
                        else
                        {
                            <p class="backoffice-results-meta">
                                Showing @FilteredReports.Count reported response@(FilteredReports.Count == 1 ? string.Empty : "s")
                            </p>

                            @foreach (var report in FilteredReports)
                            {
                                <article class="backoffice-card backoffice-list-card">
                                    <div class="backoffice-card-header">
                                        <strong>@GetReportTitle(report)</strong>
                                        <span>#@report.Id</span>
                                        <span>@report.Username</span>
                                        <span>@GetReportStatusLabel(report)</span>
                                        @if (!string.IsNullOrWhiteSpace(report.ReviewCategory))
                                        {
                                            <span>@report.ReviewCategory</span>
                                        }
                                        <span>@FormatReportTimestamp(report)</span>
                                    </div>
                                    <p class="backoffice-list-summary">@GetReportPreview(report)</p>
                                    <div class="backoffice-inline-options">
                                        <span>@(report.PromotedKnowledgeEntryId.HasValue ? $"Promoted to knowledge #{report.PromotedKnowledgeEntryId.Value}" : "Not promoted")</span>
                                        <span>@(IsTrainingCandidate(report) ? "Training candidate" : "Not training-ready")</span>
                                        @if (!string.IsNullOrWhiteSpace(report.ReviewedBy))
                                        {
                                            <span>Reviewed by @report.ReviewedBy</span>
                                        }
                                    </div>
                                    <div class="backoffice-actions">
                                        <button type="button" class="ghost-button" @onclick="() => OpenReviewModal(report)">Review</button>
                                    </div>
                                </article>
                            }
                        }
                    </section>
                }
                else if (ActiveSection == BackofficeSection.Prompts)
                {
                    <section class="backoffice-section">
                        <div class="backoffice-section-header">
                            <div>
                                <h2>Prompt Templates</h2>
                                <p>Edit the published prompt scaffolding stored in the database.</p>
                            </div>
                            <button type="button" class="ghost-button" @onclick="LoadPromptTemplatesAsync" disabled="@isBusy">Refresh</button>
                        </div>

                        @foreach (var template in PromptTemplates)
                        {
                            var draft = GetPromptDraft(template);
                            <article class="backoffice-card">
                                <div class="backoffice-card-header">
                                    <strong>@template.TemplateName</strong>
                                    <span>@template.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                                </div>
                                <label>
                                    <span title="This template text shapes how the assistant behaves for the selected prompt stage.">Content</span>
                                    <textarea class="text-input backoffice-textarea" rows="8" @bind="draft.Content"></textarea>
                                </label>
                                <div class="backoffice-inline-options">
                                    <label title="Published templates are live and can be used by the assistant."><input type="checkbox" @bind="draft.IsPublished" /> Published</label>
                                </div>
                                <div class="backoffice-actions">
                                    <button type="button" class="primary-action slim" @onclick="() => SavePromptTemplateAsync(template, draft)" disabled="@isBusy">Save template</button>
                                </div>
                            </article>
                        }
                    </section>
                }
                else if (ActiveSection == BackofficeSection.Knowledge)
                {
                    <section class="backoffice-section">
                        <div class="backoffice-section-header">
                            <div>
                                <h2>Knowledge Entries</h2>
                                <p>Manage quick answers, topics, and reference content that the documentation assistant reads from SQL.</p>
                            </div>
                            <div class="backoffice-toolbar">
                                <button type="button" class="ghost-button" @onclick="LoadKnowledgeEntriesAsync" disabled="@isBusy">Refresh</button>
                                <button type="button" class="primary-action slim" @onclick="OpenCreateKnowledgeModal">New entry</button>
                            </div>
                        </div>

                        <div class="backoffice-filters">
                            <input class="text-input"
                                   title="Search by title, source, type, summary, or content."
                                   placeholder="Search title, source, type, or content..."
                                   @bind="KnowledgeSearchTerm"
                                   @bind:event="oninput" />
                            <select class="text-input" @bind="KnowledgeTypeFilter" title="Limit the list to one knowledge entry type.">
                                <option value="">All types</option>
                                <option value="QuickAnswer">QuickAnswer</option>
                                <option value="Topic">Topic</option>
                                <option value="Reference">Reference</option>
                            </select>
                        </div>

                        @if (FilteredKnowledgeEntries.Count == 0)
                        {
                            <p class="backoffice-empty">No knowledge entries found yet.</p>
                        }
                        else
                        {
                            <p class="backoffice-results-meta">
                                Showing @KnowledgePageStart-@KnowledgePageEnd of @FilteredKnowledgeEntries.Count entries
                            </p>

                            @foreach (var entry in PagedKnowledgeEntries)
                            {
                                <article class="backoffice-card backoffice-list-card">
                                    <div class="backoffice-card-header">
                                        <strong>@entry.Title</strong>
                                        <span>@entry.EntryType</span>
                                        <span>@entry.SourceName</span>
                                        <span>@FormatKnowledgeTimestamp(entry)</span>
                                    </div>
                                    <p class="backoffice-list-summary">@GetKnowledgePreview(entry)</p>
                                    <div class="backoffice-inline-options">
                                        <span>@(entry.IsPublished ? "Published" : "Draft")</span>
                                        @if (!string.IsNullOrWhiteSpace(entry.UpdatedBy))
                                        {
                                            <span>Updated by @entry.UpdatedBy</span>
                                        }
                                    </div>
                                    <div class="backoffice-actions">
                                        <button type="button" class="ghost-button" @onclick="() => OpenEditKnowledgeModal(entry)">Edit</button>
                                    </div>
                                </article>
                            }

                            @if (KnowledgeTotalPages > 1)
                            {
                                <div class="backoffice-pagination">
                                    <button type="button" class="ghost-button" disabled="@(KnowledgePage <= 1)" @onclick="PreviousKnowledgePage">Previous</button>
                                    <span>Page @KnowledgePage of @KnowledgeTotalPages</span>
                                    <button type="button" class="ghost-button" disabled="@(KnowledgePage >= KnowledgeTotalPages)" @onclick="NextKnowledgePage">Next</button>
                                </div>
                            }
                        }
                    </section>
                }
                else if (ActiveSection == BackofficeSection.Profile)
                {
                    <section class="backoffice-section">
                        <div class="backoffice-section-header">
                            <div>
                                <h2>Profile Management</h2>
                                <p>Control how your user appears in chat without changing the authenticated account.</p>
                            </div>
                        </div>

                        <article class="backoffice-card profile-card">
                            <div class="profile-card-header">
                                <div class="avatar profile-preview-avatar">@CurrentAvatarLabel</div>
                                <div>
                                    <div class="mini-label">Chat profile preview</div>
                                    <strong>@CurrentDisplayNameOrFallback</strong>
                                    <p class="backoffice-list-summary">Signed in account: @CurrentUsernameOrFallback</p>
                                </div>
                            </div>

                            <div class="backoffice-grid">
                                <label>
                                    <span>Display name</span>
                                    <input class="text-input"
                                           @bind="displayNameDraft"
                                           @bind:event="oninput"
                                           maxlength="40"
                                           placeholder="Name shown in chat" />
                                </label>
                                <label>
                                    <span>Avatar label</span>
                                    <input class="text-input"
                                           @bind="avatarLabelDraft"
                                           @bind:event="oninput"
                                           maxlength="4"
                                           placeholder="You, GB, G" />
                                </label>
                            </div>

                            <div class="backoffice-actions">
                                <button type="button" class="ghost-button" @onclick="ResetChatProfileAsync" disabled="@isBusy">Reset</button>
                                <button type="button" class="primary-action slim" @onclick="SaveChatProfileAsync" disabled="@isBusy">Save profile</button>
                            </div>
                        </article>
                    </section>
                }
                else if (ActiveSection == BackofficeSection.Users)
                {
                    <section class="backoffice-section">
                        <div class="backoffice-section-header">
                            <div>
                                <h2>User Management</h2>
                                <p>Manage admin access, validator permissions, and application users from one place.</p>
                            </div>
                            <div class="backoffice-toolbar">
                                <button type="button" class="ghost-button" @onclick="LoadUsersAsync" disabled="@isBusy">Refresh</button>
                                <button type="button" class="primary-action slim" @onclick="OpenCreateUserModal">New user</button>
                            </div>
                        </div>

                        <div class="backoffice-filters backoffice-filters-single">
                            <input class="text-input"
                                   title="Search by username, email, or role."
                                   placeholder="Search username, email, or role..."
                                   @bind="UserSearchTerm"
                                   @bind:event="oninput" />
                        </div>

                        @if (FilteredUsers.Count == 0)
                        {
                            <p class="backoffice-empty">No users matched this filter.</p>
                        }
                        else
                        {
                            <p class="backoffice-results-meta">
                                Showing @UserPageStart-@UserPageEnd of @FilteredUsers.Count user@(FilteredUsers.Count == 1 ? string.Empty : "s")
                            </p>

                            <div class="user-management-list">
                                @foreach (var user in PagedUsers)
                                {
                                    <button type="button"
                                            class="backoffice-card backoffice-list-card user-management-card user-management-row-button"
                                            aria-label="Manage user @user.Username"
                                            @onclick="() => OpenEditUserModal(user)">
                                        <span class="user-management-row-content">
                                            <strong>@user.Username</strong>
                                            <span>@user.Email</span>
                                        </span>
                                        <svg class="action-icon user-management-row-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m9 18 6-6-6-6" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                }
            </section>
        </div>

        @if (ShowProfileManagementModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="CloseProfileManagementModal">
                <div class="backoffice-modal admin-management-modal profile-management-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Account</div>
                            <h2>Profile Management</h2>
                            <p>Control how your user appears in chat without changing the authenticated account.</p>
                        </div>
                        <button type="button" class="ghost-button modal-close-icon" aria-label="Close profile management" @onclick="CloseProfileManagementModal">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M18 6 6 18" />
                                <path d="m6 6 12 12" />
                            </svg>
                        </button>
                    </div>

                    <div class="profile-management-grid">
                        <div class="profile-form-panel">
                            <div class="backoffice-grid">
                                <label>
                                    <span>Display name</span>
                                    <input class="text-input"
                                           @bind="displayNameDraft"
                                           @bind:event="oninput"
                                           maxlength="40"
                                           placeholder="Name shown in chat" />
                                </label>
                                <label>
                                    <span>Avatar label</span>
                                    <input class="text-input"
                                           @bind="avatarLabelDraft"
                                           @bind:event="oninput"
                                           maxlength="4"
                                           placeholder="You, GB, G" />
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="backoffice-modal-actions">
                        <button type="button" class="ghost-button" @onclick="ResetChatProfileAsync" disabled="@isBusy">Reset</button>
                        <button type="button" class="primary-action slim" @onclick="SaveChatProfileAsync" disabled="@isBusy">Save profile</button>
                    </div>
                </div>
            </div>
        }

        @if (ShowReportsManagementModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="CloseReportsManagementModal">
                <div class="backoffice-modal admin-management-modal listing-management-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Validation</div>
                            <h2>Reported Responses</h2>
                            <p>Validate reported answers and promote the useful fixes into reusable knowledge.</p>
                        </div>
                        <div class="modal-header-actions">
                            <button type="button" class="ghost-button modal-refresh-button icon-label-button" @onclick="LoadReportsAsync" disabled="@isBusy">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                    <path d="M4 4v5h5" />
                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2" />
                                    <path d="M20 20v-5h-5" />
                                </svg>
                                Refresh
                            </button>
                            <button type="button" class="ghost-button modal-close-icon" aria-label="Close reported responses" @onclick="CloseReportsManagementModal">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M18 6 6 18" />
                                    <path d="m6 6 12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="listing-modal-body">
                        <section class="listing-filter-panel @(ReportsFiltersOpen ? null : "collapsed")">
                            <button type="button"
                                    class="listing-filter-toggle"
                                    aria-expanded="@ReportsFiltersOpen"
                                    @onclick="() => ReportsFiltersOpen = !ReportsFiltersOpen">
                                <span>Filters</span>
                                <small>@GetReportFilterSummary()</small>
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m6 9 6 6 6-6" />
                                </svg>
                            </button>
                            @if (ReportsFiltersOpen)
                            {
                                <div class="listing-modal-tools">
                                    <select class="text-input"
                                            value="@ReportStatusFilter"
                                            @onchange="OnReportStatusFilterChanged"
                                            title="Limit the list to one report status.">
                                        @foreach (var option in ReportStatusFilterOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                </div>
                            }
                        </section>

                        @if (FilteredReports.Count == 0)
                        {
                            <p class="backoffice-empty">No reported responses found for this filter.</p>
                        }
                        else
                        {
                            <p class="backoffice-results-meta">Showing @ReportPageStart-@ReportPageEnd of @FilteredReports.Count reports</p>
                            <div class="compact-listing-list">
                                @foreach (var report in PagedReports)
                                {
                                    <button type="button"
                                            class="compact-listing-card compact-listing-row-button"
                                            aria-label="Review @GetReportTitle(report)"
                                            @onclick="() => OpenReviewModal(report)">
                                        <div>
                                            <strong>@GetReportTitle(report)</strong>
                                        </div>
                                    </button>
                                }
                            </div>
                        }

                        @if (ReportTotalPages > 1)
                        {
                            <div class="listing-modal-pagination">
                                <button type="button" class="ghost-button" disabled="@(ReportPage <= 1)" @onclick="PreviousReportPage">Previous</button>
                                <span>Page @ReportPage of @ReportTotalPages</span>
                                <button type="button" class="ghost-button" disabled="@(ReportPage >= ReportTotalPages)" @onclick="NextReportPage">Next</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (ShowPromptsManagementModal)
        {
            <div class="backoffice-modal-backdrop" @onclick="ClosePromptsManagementModal">
                <div class="backoffice-modal admin-management-modal listing-management-modal" @onclick:stopPropagation="true">
                    <div class="backoffice-modal-header">
                        <div>
                            <div class="eyebrow">Validation</div>
                            <h2>Prompt Templates</h2>
                            <p>Edit the published prompt scaffolding stored in the database.</p>
                        </div>
                        <div class="modal-header-actions">
                            <button type="button" class="ghost-button modal-refresh-button icon-label-button" @onclick="LoadPromptTemplatesAsync" disabled="@isBusy">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 11a8.1 8.1 0 0 0-15.5-2" />
                                    <path d="M4 4v5h5" />
                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2" />
                                    <path d="M20 20v-5h-5" />
                                </svg>
                                Refresh
                            </button>
                            <button type="button" class="ghost-button modal-close-icon" aria-label="Close prompt templates" @onclick="ClosePromptsManagementModal">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M18 6 6 18" />
                                    <path d="m6 6 12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="listing-modal-body">
                        <p class="backoffice-results-meta">Showing @PromptPageStart-@PromptPageEnd of @PromptTemplates.Count templates</p>
                        <div class="compact-listing-list">
                            @foreach (var template in PagedPromptTemplates)
                            {
                                <button type="button"
                                        class="compact-listing-card prompt-template-card compact-listing-row-button"
                                        aria-label="Edit @template.TemplateName"
                                        @onclick="() => OpenEditPromptModal(template)">
                                    <div>
