                                <span title="Profile this prompt belongs to.">Profile</span>
                                <input class="text-input" @bind="promptDraft.ProfileId" />
                            </label>
                            <label>
                                <span title="Template name shown to admins.">Template name</span>
                                <input class="text-input" @bind="promptDraft.TemplateName" />
