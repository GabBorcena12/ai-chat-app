    private void AddReviewedTrainingExample()
    {
        if (string.IsNullOrWhiteSpace(manualTrainingQuestion) || string.IsNullOrWhiteSpace(manualTrainingExpectedAnswer))
        {
            SetStatus("Question and corrected answer are required.", isError: true);
            return;
        }

        TrainingWorkspace.AddReviewedReportExample(
            manualTrainingQuestion,
            manualTrainingBadResponse,
            manualTrainingExpectedAnswer,
            manualTrainingIssueType,
            manualTrainingIntent);

        manualTrainingQuestion = string.Empty;
        manualTrainingBadResponse = string.Empty;
        manualTrainingExpectedAnswer = string.Empty;
        SetStatus("Reviewed example added.");
    }

