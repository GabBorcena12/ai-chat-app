    private MarkupString RenderMessageContent(MessageViewModel message)
    {
        var normalized = NormalizeMessageForDisplay(message);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return new MarkupString("<p></p>");
        }

        var blocks = normalized
            .Split($"{Environment.NewLine}{Environment.NewLine}", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var html = new StringBuilder();
        foreach (var block in blocks)
        {
            if (TryRenderUnorderedList(block, html) || TryRenderOrderedList(block, html))
            {
                continue;
            }

            html.Append("<p>");
            html.Append(WebUtility.HtmlEncode(block).Replace(Environment.NewLine, "<br />"));
            html.Append("</p>");
        }

        return new MarkupString(html.ToString());
    }

    private static string NormalizeMessageForDisplay(MessageViewModel message)
    {
        var content = (message.Content ?? string.Empty).Replace("\r\n", "\n").Trim();
        if (string.IsNullOrWhiteSpace(content) || !string.Equals(message.Role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return content.Replace("\n", Environment.NewLine);
        }

        var bulletSeparatorCount = System.Text.RegularExpressions.Regex.Matches(content, @"\s-\s").Count;
        if (bulletSeparatorCount >= 2 && !content.Contains("\n- ", StringComparison.Ordinal))
        {
            content = System.Text.RegularExpressions.Regex.Replace(content, @"\s-\s", "\n- ");
        }

        if (!content.Contains('\n')
            && System.Text.RegularExpressions.Regex.IsMatch(content, @"\b\d+\.\s+\S+")
            && System.Text.RegularExpressions.Regex.Matches(content, @"\b\d+\.\s+").Count >= 2)
        {
            content = System.Text.RegularExpressions.Regex.Replace(content, @"\s(?=\d+\.\s)", "\n");
        }

        return content.Replace("\n", Environment.NewLine);
    }

    private static bool TryRenderUnorderedList(string block, StringBuilder html)
    {
        var lines = block.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length < 2 || lines.Count(line => line.StartsWith("- ", StringComparison.Ordinal)) < 2)
        {
            return false;
        }

        var introLines = lines.TakeWhile(line => !line.StartsWith("- ", StringComparison.Ordinal)).ToList();
        var itemLines = lines.Skip(introLines.Count).ToList();
        if (itemLines.Count < 2 || itemLines.Any(line => !line.StartsWith("- ", StringComparison.Ordinal)))
        {
            return false;
        }

        if (introLines.Count > 0)
        {
            html.Append("<p>");
            html.Append(WebUtility.HtmlEncode(string.Join(" ", introLines)));
            html.Append("</p>");
        }

        html.Append("<ul class=\"message-list\">");
        foreach (var item in itemLines)
        {
            html.Append("<li>");
            html.Append(WebUtility.HtmlEncode(item[2..].Trim()));
            html.Append("</li>");
        }
        html.Append("</ul>");
        return true;
    }

    private static bool TryRenderOrderedList(string block, StringBuilder html)
    {
        var lines = block.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length < 2)
        {
            return false;
        }

        var introLines = lines.TakeWhile(line => !System.Text.RegularExpressions.Regex.IsMatch(line, @"^\d+\.\s+")).ToList();
        var itemLines = lines.Skip(introLines.Count).ToList();
        if (itemLines.Count < 2 || itemLines.Any(line => !System.Text.RegularExpressions.Regex.IsMatch(line, @"^\d+\.\s+")))
        {
            return false;
        }

        if (introLines.Count > 0)
        {
            html.Append("<p>");
            html.Append(WebUtility.HtmlEncode(string.Join(" ", introLines)));
            html.Append("</p>");
        }

        html.Append("<ol class=\"message-list ordered\">");
        foreach (var item in itemLines)
        {
            var cleaned = System.Text.RegularExpressions.Regex.Replace(item, @"^\d+\.\s+", string.Empty);
            html.Append("<li>");
            html.Append(WebUtility.HtmlEncode(cleaned.Trim()));
            html.Append("</li>");
        }
        html.Append("</ol>");
        return true;
    }

    private async Task CopyMessageAsync(MessageViewModel message)
    {
        await JS.InvokeVoidAsync("aiChatUi.copyText", message.Content);
        copiedMessageId = message.Id;
        _ = ShowToastAsync("Copied to clipboard.");
        await InvokeAsync(StateHasChanged);
        _ = ClearCopiedStateAsync(message.Id);
    }

    private async Task ToggleSpeechAsync(MessageViewModel message)
    {
        if (speakingMessageId == message.Id)
        {
            await JS.InvokeVoidAsync("aiChatUi.stopSpeaking");
            speakingMessageId = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        speakingMessageId = message.Id;
        await InvokeAsync(StateHasChanged);

        try
        {
            var completed = await JS.InvokeAsync<bool>("aiChatUi.speakText", message.Content);
            if (!completed)
            {
                ChatStatus = "Text to speech is not available in this browser.";
            }
        }
        catch
        {
            ChatStatus = "Text to speech is not available in this browser.";
        }
        finally
        {
            if (speakingMessageId == message.Id)
            {
                speakingMessageId = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void RequestReportConfirmation(MessageViewModel message)
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        pendingReportMessage = message;
    }

    private void CancelReportConfirmation()
        => pendingReportMessage = null;

    private async Task ConfirmReportAsync()
    {
        if (pendingReportMessage is null)
        {
            return;
        }

        var message = pendingReportMessage;
        pendingReportMessage = null;
        await ReportMessageAsync(message);
    }

    private async Task ReportMessageAsync(MessageViewModel message)
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        var previousUserMessage = FindPreviousUserMessage(message)?.Content ?? string.Empty;

        try
        {
            isBusy = true;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var response = await GatewayClient.ReportResponseAsync(
                token!,
                new ReportChatResponsePayload
                {
                    ChatId = ActiveConversation.Id,
                    MessageId = message.Id,
                    Username = CurrentUsernameOrFallback,
                    UserPrompt = previousUserMessage,
                    AssistantResponse = message.Content,
                    ContextMode = "documentation",
                    WasUpdated = (message.LastUpdatedAt ?? message.CreatedAt) > message.CreatedAt.AddSeconds(1)
                },
                cts.Token);

            reportedMessageId = message.Id;
            ChatStatus = response;
            await ShowCompletionNotificationAsync(AssistantProfile.ReportSavedNotification);
            await InvokeAsync(StateHasChanged);
            _ = ClearReportedStateAsync(message.Id);
        }
        catch (Exception ex)
        {
            if (IsInvalidSessionError(ex))
            {
                await EndInvalidSessionAsync(ex.Message);
                return;
            }

            ChatStatus = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void RequestContinueConfirmation(MessageViewModel message)
    {
        if (!EnsureAuthenticated() || isStreaming)
        {
            return;
        }

        pendingContinueMessage = message;
    }

    private void CancelContinueConfirmation()
        => pendingContinueMessage = null;

    private async Task ConfirmContinueAsync()
    {
        if (pendingContinueMessage is null)
        {
            return;
        }

        var message = pendingContinueMessage;
        pendingContinueMessage = null;
        await ContinueResponseAsync(message);
    }

    private async Task ContinueResponseAsync(MessageViewModel message)
    {
        if (!EnsureAuthenticated() || isStreaming)
        {
            return;
        }

        var originalContent = message.Content;
        var sourceQuestion = FindPreviousUserMessage(message)?.Content ?? string.Empty;

        isStreaming = true;
        message.IsStreaming = true;
        ChatStatus = "Continuing response...";
        await InvokeAsync(StateHasChanged);

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));
            var response = await GatewayClient.ContinueAsync(
                token!,
                new ContinueChatRequestPayload
                {
                    ChatId = ActiveConversation.Id,
                    User = CurrentUsernameOrFallback,
                    OriginalPrompt = sourceQuestion,
                    PartialResponse = originalContent,
                    ContextMode = "documentation"
                },
                cts.Token);

            message.Content = MergeContinuation(originalContent, response.Response);
            message.LastUpdatedAt = DateTimeOffset.Now;
            ChatStatus = AssistantProfile.ResponseCompleteStatus;
            QueueScrollToLatest(force: true);
            await ShowCompletionNotificationAsync(AssistantProfile.ContinuationCompleteNotification);
        }
        catch (Exception ex)
        {
            if (IsInvalidSessionError(ex))
            {
                await EndInvalidSessionAsync(ex.Message);
                return;
            }

            message.Content = originalContent;
            ChatStatus = ex.Message;
        }
        finally
        {
            isStreaming = false;
            message.IsStreaming = false;
            await PersistConversationsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void QueueScrollToLatest(bool force = false)
    {
        pendingScrollToLatest = true;
        forceNextScrollToLatest = forceNextScrollToLatest || force;
    }

    private async Task EnsureMessageRailTrackingAsync()
    {
        if (messageRailRegistered)
        {
            return;
        }

        await JS.InvokeVoidAsync("aiChatUi.registerMessageRail", messageRailRef, AutoScrollThreshold);
        messageRailRegistered = true;
    }

    private async Task FlushPendingScrollAsync()
    {
        if (!pendingScrollToLatest)
        {
            return;
        }

        if (forceNextScrollToLatest)
        {
            await JS.InvokeVoidAsync("aiChatUi.scrollToBottom", messageRailRef, true, false);
        }
        else
        {
            await JS.InvokeAsync<bool>("aiChatUi.scrollToBottomIfFollowing", messageRailRef);
        }

        pendingScrollToLatest = false;
        forceNextScrollToLatest = false;
    }

    private bool EnsureAuthenticated()
    {
        if (IsAuthenticated)
        {
            return true;
        }

        AuthMessage = AssistantProfile.AuthRequiredMessage;
        isAuthModalOpen = true;
        OpenSidebarSection(SidebarSection.Account);
        return false;
    }

    private async Task EndInvalidSessionAsync(string message)
    {
        token = null;
        CurrentUsername = null;
        CurrentDisplayName = null;
        CurrentAvatar = null;
        twoFactorSetup = null;
        twoFactorCode = string.Empty;
        isTwoFactorEnabled = false;
        TwoFactorStatus = null;
        AuthMessage = "Your session expired or no longer matches the running API. Please sign in again.";
        ChatStatus = message;

        await BrowserStorage.RemoveAsync(TokenStorageKey);
        await BrowserStorage.RemoveAsync(UserStorageKey);
        ResetConversationWorkspace();
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsInvalidSessionError(Exception ex)
        => ex.Message.Contains("session is no longer valid", StringComparison.OrdinalIgnoreCase)
           || ex.Message.Contains("invalid_token", StringComparison.OrdinalIgnoreCase)
           || ex.Message.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase);

    private async Task RefreshTwoFactorStatusAsync(CancellationToken cancellationToken = default)
    {
        if (!IsAuthenticated)
        {
            isTwoFactorEnabled = false;
            return;
        }

        try
        {
            isTwoFactorEnabled = await GatewayClient.GetTwoFactorStatusAsync(token!, cancellationToken);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to refresh 2FA status.");
        }
    }

    private async Task RunBusyAction(Func<CancellationToken, Task> action)
    {
        isBusy = true;
        AuthMessage = null;
        TwoFactorStatus = null;

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            await action(cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "UI action failed.");
            AuthMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildConversationTitle(string prompt)
    {
        var title = prompt.Length > 38 ? $"{prompt[..38]}..." : prompt;
        return string.IsNullOrWhiteSpace(title) ? "New conversation" : title;
    }

    private static bool IsProbablyIncomplete(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return false;
        }

        var trimmed = content.Trim();
        if (trimmed.Length < 24)
        {
            return true;
        }

        if (trimmed.EndsWith(":") || trimmed.EndsWith("-") || trimmed.EndsWith(",") || trimmed.EndsWith("..."))
        {
            return true;
        }

        return System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"\b(and|or|with|for|to|of|in)\s*$", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
               || !System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"[.!?]$");
    }

    private MessageViewModel? FindPreviousUserMessage(MessageViewModel assistantMessage)
    {
        var index = ActiveConversation.Messages.FindIndex(x => x.Id == assistantMessage.Id);
        if (index <= 0)
        {
            return null;
        }

        for (var i = index - 1; i >= 0; i--)
        {
            if (ActiveConversation.Messages[i].Role == "user")
            {
                return ActiveConversation.Messages[i];
            }
        }

        return null;
    }

    private static string MergeContinuation(string original, string continuation)
    {
        if (string.IsNullOrWhiteSpace(continuation))
        {
            return original;
        }

        var cleanedContinuation = continuation.Trim();
        if (cleanedContinuation.StartsWith(original, StringComparison.OrdinalIgnoreCase))
        {
            cleanedContinuation = cleanedContinuation[original.Length..].TrimStart();
        }

        var overlap = FindOverlapLength(original, cleanedContinuation);
        if (overlap > 0)
        {
            cleanedContinuation = cleanedContinuation[overlap..].TrimStart();
        }

        if (string.IsNullOrWhiteSpace(cleanedContinuation))
        {
            return original;
        }

        var separator = string.IsNullOrWhiteSpace(original) || char.IsWhiteSpace(original[^1]) ? string.Empty : " ";
        return $"{original}{separator}{cleanedContinuation}";
    }

    private static int FindOverlapLength(string original, string continuation)
    {
        var max = Math.Min(original.Length, continuation.Length);
        for (var length = max; length >= 12; length--)
        {
            if (original.EndsWith(continuation[..length], StringComparison.OrdinalIgnoreCase))
            {
                return length;
            }
        }

        return 0;
    }

