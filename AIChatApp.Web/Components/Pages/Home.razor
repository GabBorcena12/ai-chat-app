    private async Task RestoreConversationsAsync()
    {
        var state = await BrowserStorage.GetJsonAsync<ConversationWorkspaceState>(ConversationStorageKey);
        if (state?.Conversations is null || state.Conversations.Count == 0)
        {
            if (Conversations.Count == 0)
            {
                ResetConversationWorkspace();
            }
            return;
        }

        Conversations.Clear();
        foreach (var conversation in state.Conversations)
        {
            conversation.IsRenaming = false;
            conversation.DraftTitle = conversation.Title;
            conversation.Messages ??= [];

            foreach (var message in conversation.Messages)
            {
                message.IsStreaming = false;
                if (message.CreatedAt == default)
                {
                    message.CreatedAt = DateTimeOffset.Now;
                }
                if (message.LastUpdatedAt == default || message.LastUpdatedAt is null)
                {
                    message.LastUpdatedAt = message.CreatedAt;
                }
            }

            Conversations.Add(conversation);
        }

        ActiveConversation = Conversations.FirstOrDefault(x => x.Id == state.ActiveConversationId) ?? Conversations[0];
        QueueScrollToLatest(force: true);
    }

    private void ResetConversationWorkspace()
    {
        Conversations.Clear();
        ActiveConversation = new ConversationViewModel();
        Conversations.Add(ActiveConversation);
        ChatStatus = null;
        promptText = string.Empty;
    }

    private void PersistConversations()
    {
        if (!initialized)
        {
            return;
        }

        _ = PersistConversationsAsync();
    }

    private ValueTask PersistConversationsAsync()
    {
        if (!initialized)
        {
            return ValueTask.CompletedTask;
        }

        var state = new ConversationWorkspaceState
        {
            ActiveConversationId = ActiveConversation.Id,
            Conversations = Conversations
        };

        return BrowserStorage.SetJsonAsync(ConversationStorageKey, state);
    }

    private static string GetQrCodeUrl(string authenticatorUri)
        => $"https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={Uri.EscapeDataString(authenticatorUri)}";

    private static string FormatMessageTimestamp(string role, DateTimeOffset createdAt, DateTimeOffset? lastUpdatedAt)
    {
        var baseLocal = createdAt.ToLocalTime();
        var updatedLocal = (lastUpdatedAt ?? createdAt).ToLocalTime();
        var wasUpdated = updatedLocal > baseLocal.AddSeconds(1);

        if (wasUpdated)
        {
            return $"Updated {updatedLocal:MMM d, yyyy h:mm tt}";
        }

        var prefix = string.Equals(role, "user", StringComparison.OrdinalIgnoreCase) ? "Sent" : "Received";
        return $"{prefix} {baseLocal:MMM d, yyyy h:mm tt}";
    }
