@page "/"
@page "/chat"
@rendermode InteractiveServer
@using AIChatApp.Core.Config
@using AIChatApp.Web.Config
@using System.Net
@using System.Text
@inject AIChatApp.Web.Services.AIChatGatewayClient GatewayClient
@inject AIChatApp.Web.Services.BrowserStorageService BrowserStorage
@inject AIChatApp.Web.Services.FaqContentService FaqContent
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<AssistantProfileOptions> AssistantProfileOptionsAccessor
@inject Microsoft.Extensions.Options.IOptions<FrontendOptions> FrontendOptionsAccessor

<PageTitle>@AssistantProfile.PageTitle</PageTitle>

<div class="chat-app @(isSidebarOpen ? "sidebar-open" : null) @(isSidebarNavHidden ? "sidebar-nav-hidden" : null)">
    @if (!string.IsNullOrWhiteSpace(CompletionNotice))
    {
        <div class="completion-toast" role="status" aria-live="polite">@CompletionNotice</div>
    }

    <aside class="sidebar">
        <div class="brand-card">
                <div class="brand-symbol" aria-hidden="true">
                    <img src="chat-assistant-logo.png" alt="" />
                </div>
                <div>
                    <div class="eyebrow">@AssistantProfile.SidebarEyebrow</div>
                    <h2 @onclick="HandleBrandTitleClick" class="brand-title-link">@AssistantProfile.SidebarTitle</h2>
                    <div class="sidebar-user-badge @(IsAuthenticated ? "signed-in" : "signed-out")">
                        <span class="sidebar-user-avatar">@(IsAuthenticated ? CurrentAvatarLabel : "AI")</span>
                        <span class="sidebar-user-copy">
                            <strong>@(IsAuthenticated ? CurrentDisplayNameOrFallback : "Guest user")</strong>
                            <small>@(IsAuthenticated ? $"@{CurrentUsernameOrFallback}" : AssistantProfile.HeaderAuthRequiredLabel)</small>
                        </span>
                    </div>
                </div>
                <button type="button" class="ghost-button sidebar-nav-toggle-button nav-image-button" aria-label="Hide side navigation" title="Hide side navigation" @onclick="HideSidebarNav">
                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="16" rx="3" />
                        <path d="M9 4v16" />
                        <path d="m15 9-3 3 3 3" />
                    </svg>
                </button>
            </div>

        <button class="primary-action" @onclick="StartNewConversationAsync">
            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>
            <span>@AssistantProfile.NewChatLabel</span>
        </button>

        @if (IsAuthenticated)
        {
            <section class="sidebar-section collapsible-sidebar-section @(conversationsSectionOpen ? null : "collapsed")">
                <button type="button"
                        class="sidebar-section-toggle"
                        aria-expanded="@conversationsSectionOpen"
                        @onclick="() => ToggleSidebarSection(SidebarSection.Conversations)">
                    <span>Conversations</span>
                    <strong class="section-toggle-icon" aria-hidden="true">
                        <svg class="action-icon" viewBox="0 0 24 24">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </strong>
                </button>
                @if (conversationsSectionOpen)
                {
                    <div class="conversation-list">
                    @foreach (var conversation in Conversations)
                    {
                        <div class="conversation-item @(conversation.Id == ActiveConversation.Id ? "active" : null)">
                            @if (conversation.IsRenaming)
                            {
                                <div class="conversation-editor">
                                    <input class="conversation-title-input"
                                           @bind="conversation.DraftTitle"
                                           @bind:event="oninput"
                                           @onkeydown="args => HandleRenameKeyDown(args, conversation)"
                                           maxlength="80" />
                                    <div class="conversation-actions">
                                        <button type="button" class="ghost-button conversation-action" @onclick="() => SaveConversationTitle(conversation)">Save</button>
                                        <button type="button" class="ghost-button conversation-action" @onclick="() => CancelConversationRename(conversation)">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="conversation-select"
                                        @onclick="() => SelectConversationAsync(conversation.Id)">
                                    <span class="conversation-title">@conversation.Title</span>
                                    <span class="conversation-count">@conversation.Messages.Count messages</span>
                                </button>
                                <div class="conversation-actions">
                                    <button type="button"
                                            class="ghost-button conversation-rename-button"
                                            title="Rename conversation"
                                            @onclick="() => BeginConversationRename(conversation)">
                                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" />
                                        </svg>
                                        <span>Rename</span>
                                    </button>
                                    <button type="button"
                                            class="ghost-button conversation-delete-button"
                                            title="Delete conversation"
                                            aria-label="Delete conversation"
                                            @onclick="() => DeleteConversation(conversation)">
                                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 6h18" />
                                            <path d="M8 6V4h8v2" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                            <path d="M10 11v5" />
                                            <path d="M14 11v5" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    </div>
                }
            </section>
        }

        <section class="sidebar-section collapsible-sidebar-section @(workspaceSectionOpen ? null : "collapsed")">
            <button type="button"
                    class="sidebar-section-toggle"
                    aria-expanded="@workspaceSectionOpen"
                    @onclick="() => ToggleSidebarSection(SidebarSection.Workspaces)">
                <span>Workspaces</span>
                <strong class="section-toggle-icon" aria-hidden="true">
                    <svg class="action-icon" viewBox="0 0 24 24">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </strong>
            </button>
            @if (workspaceSectionOpen)
            {
                <nav class="workspace-nav" aria-label="Workspace navigation">
                    <button type="button" class="workspace-nav-link app-chat active" @onclick='() => NavigateFromSidebarAsync("/chat")'>
                        <span class="workspace-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z" />
                            </svg>
                        </span>
                        <span class="workspace-copy">
                            <span>Chat</span>
                            <small>Main assistant</small>
                        </span>
                        <span class="workspace-state">Active</span>
                    </button>
                    <button type="button" class="workspace-nav-link app-backoffice" @onclick='() => NavigateFromSidebarAsync("/backoffice")'>
                        <span class="workspace-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="M4 4h16v16H4z" />
                                <path d="M8 9h8" />
                                <path d="M8 13h5" />
                                <path d="M8 17h8" />
                            </svg>
                        </span>
                        <span class="workspace-copy">
                            <span>Backoffice</span>
                            <small>Validate answers</small>
                        </span>
                    </button>
                    <a class="workspace-nav-link app-ml"
                       href="@FrontendOptions.MlTrainingUrl">
                        <span class="workspace-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="M4 19V5" />
                                <path d="M8 19v-7" />
                                <path d="M12 19V8" />
                                <path d="M16 19v-4" />
                                <path d="M20 19V9" />
                            </svg>
                        </span>
                        <span class="workspace-copy">
                            <span>ML Training</span>
                            <small>Train reviewer</small>
                        </span>
                    </a>
                    <button type="button" class="workspace-nav-link app-faq compact" @onclick="OpenFaqModalAsync">
                        <span class="workspace-icon" aria-hidden="true">
                            <svg class="action-icon" viewBox="0 0 24 24">
                                <path d="M9 9a3 3 0 1 1 4 2.83c-.75.38-1 .82-1 1.67" />
                                <path d="M12 17h.01" />
                                <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                        </span>
                        <span class="workspace-copy">
                            <span>FAQs</span>
                            <small>Knowledge base</small>
                        </span>
                    </button>
                </nav>
            }
        </section>

        <section class="sidebar-section account-panel collapsible-sidebar-section @(accountSectionOpen ? null : "collapsed")">
            <button type="button"
                    class="sidebar-section-toggle"
                    aria-expanded="@accountSectionOpen"
                    @onclick="() => ToggleSidebarSection(SidebarSection.Account)">
                <span>Account</span>
                <strong class="section-toggle-icon" aria-hidden="true">
                    <svg class="action-icon" viewBox="0 0 24 24">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </strong>
            </button>
            @if (accountSectionOpen)
            {
                <div class="account-nav-list" aria-label="Account shortcuts">
                    @if (!IsAuthenticated)
                    {
                        <button type="button"
                                class="account-nav-item"
                                @onclick="OpenAuthModalAsync">
                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                                <path d="m10 17 5-5-5-5" />
                                <path d="M15 12H3" />
                            </svg>
                            <span>Sign in / Register</span>
                        </button>
                    }
                    else
                    {
                    <button type="button"
                            class="account-nav-item @(activeAccountPanel == "profile" ? "active" : null)"
                            @onclick="OpenProfileModalAsync">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 21a8 8 0 1 0-16 0" />
                            <path d="M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        </svg>
                        <span>Profile</span>
                    </button>
                    <button type="button"
                            class="account-nav-item @(activeAccountPanel == "security" ? "active" : null)"
                            @onclick="OpenSecurityModal">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                            <path d="m9 12 2 2 4-5" />
                        </svg>
                        <span>Security</span>
                    </button>
                    <button type="button"
                            class="account-nav-item @(activeAccountPanel == "preferences" ? "active" : null)"
                            @onclick="OpenPreferencesModalAsync">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
                            <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6l-.04.07a2 2 0 1 1-3.46 0l-.04-.07a1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1l-.07-.04a2 2 0 1 1 0-3.46l.07-.04a1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6l.04-.07a2 2 0 1 1 3.46 0l.04.07a1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.22.37.52.68.88.9l.07.04a2 2 0 1 1 0 3.46l-.07.04c-.36.22-.66.53-.88.9Z" />
                        </svg>
                        <span>Preferences</span>
                    </button>
                    }
                </div>
            }
        </section>

        @if (IsAuthenticated)
        {
            <button type="button"
                    class="ghost-button sidebar-logout-button"
                    @onclick="LogoutAsync">
                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M10 17 15 12l-5-5" />
                    <path d="M15 12H3" />
                    <path d="M21 19V5a2 2 0 0 0-2-2h-6" />
                </svg>
                <span>Logout</span>
            </button>
        }
    </aside>

    <main class="chat-stage">
        <header class="chat-header">
            <button type="button" class="ghost-button sidebar-toggle-button nav-image-button" aria-label="@(isSidebarNavHidden ? "Show side navigation" : "Open conversations and account menu")" @onclick="ToggleSidebar">
                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                    @if (isSidebarNavHidden)
                    {
                        <rect x="3" y="4" width="18" height="16" rx="3" />
                        <path d="M9 4v16" />
                        <path d="m12 9 3 3-3 3" />
                    }
                    else
                    {
                        <path d="M4 7h16" />
                        <path d="M4 12h16" />
                        <path d="M4 17h16" />
                    }
                </svg>
            </button>
            <div class="chat-title-block">
                <div class="eyebrow">@AssistantProfile.WorkspaceEyebrow</div>
                <h2>
                    <span>@ActiveConversation.Title</span>
                    <svg class="title-chevron action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </h2>
            </div>
            <div class="header-meta">
                <span class="header-status-pill">
                    <span class="status-dot" aria-hidden="true"></span>
                    @(isStreaming ? AssistantProfile.HeaderAnsweringLabel : AssistantProfile.HeaderReadyLabel)
                </span>
                <span class="avatar header-user-avatar" aria-label="Current user">@CurrentAvatarLabel</span>
            </div>
        </header>

        <section class="message-rail" @ref="messageRailRef">
            @if (ActiveConversation.Messages.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-card">
                        <div class="eyebrow">@AssistantProfile.EmptyStateEyebrow</div>
                        <h3>@AssistantProfile.EmptyStateTitle</h3>
                        <p>@AssistantProfile.EmptyStateBody</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var message in ActiveConversation.Messages)
                {
                    <article class="message-card @message.Role">
                        <div class="avatar">
                            @if (message.Role == "user")
                            {
                                @CurrentAvatarLabel
                            }
                            else
                            {
                                <span>AI</span>
                            }
                        </div>
                        <div class="message-body">
                            <div class="message-role">@(message.Role == "user" ? CurrentDisplayNameOrFallback : AssistantProfile.AssistantName)</div>
                            <div class="message-content">@RenderMessageContent(message)</div>
                            <div class="message-timestamp">@FormatMessageTimestamp(message.Role, message.CreatedAt, message.LastUpdatedAt)</div>
                            @if (message.Role == "assistant" && !message.IsStreaming)
                            {
                                <div class="message-actions">
                                    <button type="button"
                                            class="ghost-button message-action-button icon-action-button"
                                            title="@(copiedMessageId == message.Id ? "Copied" : "Copy response")"
                                            aria-label="@(copiedMessageId == message.Id ? "Copied" : "Copy response")"
                                            @onclick="() => CopyMessageAsync(message)">
                                        @if (copiedMessageId == message.Id)
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M20 6 9 17l-5-5" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="8" y="8" width="10" height="12" rx="2" />
                                                <path d="M6 16H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        }
                                    </button>
                                    <button type="button"
                                            class="ghost-button message-action-button icon-action-button"
                                            title="@(speakingMessageId == message.Id ? "Stop reading" : "Read response")"
                                            aria-label="@(speakingMessageId == message.Id ? "Stop reading" : "Read response")"
                                            @onclick="() => ToggleSpeechAsync(message)">
                                        @if (speakingMessageId == message.Id)
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <rect x="6" y="6" width="12" height="12" rx="2" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M4 9v6h4l5 4V5L8 9H4Z" />
                                                <path d="M16 9.5a4 4 0 0 1 0 5" />
                                                <path d="M18.5 7a7 7 0 0 1 0 10" />
                                            </svg>
                                        }
                                    </button>
                                    <button type="button"
                                            class="ghost-button message-action-button icon-action-button"
                                            title="@(reportedMessageId == message.Id ? "Reported" : "Report response")"
                                            aria-label="@(reportedMessageId == message.Id ? "Reported" : "Report response")"
                                            disabled="@isStreaming"
                                            @onclick="() => RequestReportConfirmation(message)">
                                        @if (reportedMessageId == message.Id)
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M20 6 9 17l-5-5" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M5 4v16" />
                                                <path d="M5 5h11l-1.5 4L16 13H5" />
                                            </svg>
                                        }
                                    </button>
                                    @if (IsProbablyIncomplete(message.Content))
                                    {
                                        <button type="button"
                                                class="ghost-button message-action-button icon-action-button"
                                                title="Continue response"
                                                aria-label="Continue response"
                                                disabled="@isStreaming"
                                                @onclick="() => RequestContinueConfirmation(message)">
                                            <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M5 12h12" />
                                                <path d="m13 6 6 6-6 6" />
                                            </svg>
                                        </button>
                                    }
                                </div>
                            }
                            @if (message.IsStreaming)
                            {
                                <span class="stream-dot"></span>
                            }
                        </div>
                    </article>
                }
            }
        </section>

        <footer class="composer">
            <div class="composer-topbar">
                @if (!string.IsNullOrWhiteSpace(ChatStatus))
                {
                    <p class="status-note chat-status">@ChatStatus</p>
                }

                <button type="button" class="ghost-button jump-latest-button" @onclick="ScrollToLatestAsync">
                    Latest
                </button>
            </div>

            <form class="composer-form" @onsubmit="SendPromptSubmitAsync" @onsubmit:preventDefault="true">
                <textarea @bind="promptText"
                          @bind:event="oninput"
                          @onkeydown="HandleComposerKeyDown"
                          class="composer-input"
                          placeholder="Message the assistant..."
                          disabled="@(!IsAuthenticated || isStreaming)"
                          rows="2"></textarea>
                <div class="composer-bar">
                    <span class="composer-tip">Enter sends. Shift+Enter adds a new line.</span>
                    <button type="submit" class="primary-action" disabled="@(!IsAuthenticated || isStreaming || string.IsNullOrWhiteSpace(promptText))">
                        @(isStreaming ? "Thinking..." : "Send")
                    </button>
                </div>
            </form>
        </footer>
    </main>

    @if (isAuthModalOpen)
    {
        <div class="modal-backdrop app-modal-backdrop" role="presentation" @onclick="CloseAuthModal">
            <section class="confirm-dialog app-modal auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title" @onclick:stopPropagation="true">
                <header class="app-modal-header">
                    <div>
                        <div class="eyebrow">Account access</div>
                        <h3 id="auth-modal-title">Sign in to AIChatApp</h3>
                    </div>
                    <button type="button" class="ghost-button modal-close-button" aria-label="Close account dialog" @onclick="CloseAuthModal">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </header>

                <div class="auth-tabs modal-tabs">
                    <button type="button" class="tab-button @(showRegister ? null : "active")" @onclick="() => showRegister = false">Sign in</button>
                    <button type="button" class="tab-button @(showRegister ? "active" : null)" @onclick="() => showRegister = true">Register</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(AuthMessage))
                {
                    <p class="status-note compact-note">@AuthMessage</p>
                }

                @if (showRegister)
                {
                    <EditForm Model="registerModel" OnValidSubmit="RegisterAsync" class="auth-form modal-form">
                        <DataAnnotationsValidator />
                        <InputText @bind-Value="registerModel.Username" class="text-input" placeholder="Username" />
                        <ValidationMessage For="@(() => registerModel.Username)" />
                        <InputText @bind-Value="registerModel.Email" class="text-input" placeholder="Email" />
                        <ValidationMessage For="@(() => registerModel.Email)" />
                        <InputText @bind-Value="registerModel.Password" class="text-input" placeholder="Password" type="password" />
                        <ValidationMessage For="@(() => registerModel.Password)" />
                        <button type="submit" class="primary-action slim" disabled="@isBusy">@(isBusy ? "Creating..." : "Create account")</button>
                    </EditForm>
                }
                else
                {
                    <EditForm Model="loginModel" OnValidSubmit="LoginAsync" class="auth-form modal-form">
                        <DataAnnotationsValidator />
                        <InputText @bind-Value="loginModel.Username" class="text-input" placeholder="Username" />
                        <ValidationMessage For="@(() => loginModel.Username)" />
                        <InputText @bind-Value="loginModel.Password" class="text-input" placeholder="Password" type="password" />
                        <ValidationMessage For="@(() => loginModel.Password)" />
                        <InputText @bind-Value="loginModel.OtpCode" class="text-input" placeholder="OTP code (when 2FA is enabled)" />
                        <button type="submit" class="primary-action slim" disabled="@isBusy">@(isBusy ? "Signing in..." : "Sign in")</button>
                    </EditForm>
                }
            </section>
        </div>
    }

    @if (isSecurityModalOpen)
    {
        <div class="modal-backdrop app-modal-backdrop" role="presentation" @onclick="CloseSecurityModal">
            <section class="confirm-dialog app-modal security-modal" role="dialog" aria-modal="true" aria-labelledby="security-modal-title" @onclick:stopPropagation="true">
                <header class="app-modal-header">
                    <div>
                        <div class="eyebrow">Security</div>
                        <h3 id="security-modal-title">Google Authenticator</h3>
                    </div>
                    <span class="status-pill @SecurityPillClass">@SecurityPillText</span>
                    <button type="button" class="ghost-button modal-close-button" aria-label="Close security dialog" @onclick="CloseSecurityModal">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </header>

                <div class="two-factor-stack security-card modal-security-card">
                    @if (isTwoFactorEnabled)
                    {
                        <p class="security-copy">Your account is protected with a time-based one-time password. You can replace the device or disable 2FA from here.</p>

                        <div class="action-row">
                            <button type="button" class="ghost-button" @onclick="SetupTwoFactorAsync" disabled="@isBusy">Set up a new device</button>
                        </div>

                        <label class="field-label" for="disable-2fa-code">Authenticator code</label>
                        <input id="disable-2fa-code" @bind="twoFactorCode" @bind:event="oninput" class="text-input" placeholder="Enter a fresh 6-digit code to disable 2FA" inputmode="numeric" />

                        @if (!string.IsNullOrWhiteSpace(TwoFactorStatus))
                        {
                            <p class="status-note compact-note">@TwoFactorStatus</p>
                        }

                        <div class="action-row">
                            <button type="button" class="ghost-button danger-button" @onclick="DisableTwoFactorAsync" disabled="@isBusy || string.IsNullOrWhiteSpace(twoFactorCode)">Disable 2FA</button>
                        </div>
                    }
                    else if (twoFactorSetup is not null)
                    {
                        <div class="two-factor-card">
                            <div class="mini-label">Step 1</div>
                            <img class="qr-code" src="@GetQrCodeUrl(twoFactorSetup.AuthenticatorUri)" alt="Google Authenticator QR code" />
                            <p class="qr-help">Scan this QR code in Google Authenticator, then type the current 6-digit code below to finish setup.</p>
                        </div>

                        <label class="field-label" for="enable-2fa-code">Authenticator code</label>
                        <input id="enable-2fa-code" @bind="twoFactorCode" @bind:event="oninput" class="text-input" placeholder="Enter the code from Google Authenticator" inputmode="numeric" />

                        @if (!string.IsNullOrWhiteSpace(TwoFactorStatus))
                        {
                            <p class="status-note compact-note">@TwoFactorStatus</p>
                        }

                        <div class="action-row">
                            <button type="button" class="primary-action slim" @onclick="VerifyTwoFactorAsync" disabled="@isBusy">@(isBusy ? "Confirming..." : "Confirm setup")</button>
                            <button type="button" class="ghost-button" @onclick="CancelTwoFactorSetup">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <p class="security-copy">Add a second layer of protection to your account with Google Authenticator.</p>

                        @if (!string.IsNullOrWhiteSpace(TwoFactorStatus))
                        {
                            <p class="status-note compact-note">@TwoFactorStatus</p>
                        }

                        <button type="button" class="primary-action slim" @onclick="SetupTwoFactorAsync" disabled="@isBusy">@(isBusy ? "Preparing..." : "Set up Google Authenticator")</button>
                    }
                </div>
            </section>
        </div>
    }

    @if (isAccountDetailModalOpen)
    {
        <div class="modal-backdrop app-modal-backdrop" role="presentation" @onclick="CloseAccountDetailModal">
            <section class="confirm-dialog app-modal account-detail-modal" role="dialog" aria-modal="true" aria-labelledby="account-detail-modal-title" @onclick:stopPropagation="true">
                <header class="app-modal-header">
                    <div>
                        <div class="eyebrow">Account</div>
                        <h3 id="account-detail-modal-title">@(activeAccountPanel == "preferences" ? "Preferences" : "Profile")</h3>
                    </div>
                    <button type="button" class="ghost-button modal-close-button" aria-label="Close account details" @onclick="CloseAccountDetailModal">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </header>

                <div class="account-modal-body">
                    @if (!string.IsNullOrWhiteSpace(AuthMessage))
                    {
                        <p class="status-note compact-note account-modal-status">@AuthMessage</p>
                    }

                    @if (activeAccountPanel == "preferences")
                    {
                        <div class="account-detail-card account-modal-card">
                            <div class="account-modal-icon" aria-hidden="true">
                                <svg class="action-icon" viewBox="0 0 24 24">
                                    <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
                                    <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6l-.04.07a2 2 0 1 1-3.46 0l-.04-.07a1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1l-.07-.04a2 2 0 1 1 0-3.46l.07-.04a1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6l.04-.07a2 2 0 1 1 3.46 0l.04.07a1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.22.37.52.68.88.9l.07.04a2 2 0 1 1 0 3.46l-.07.04c-.36.22-.66.53-.88.9Z" />
                                </svg>
                            </div>
                            <div>
                                <div class="mini-label">Preferences</div>
                                <strong>Chat preferences</strong>
                                <small>Display name, avatar, and assistant settings live in Backoffice.</small>
                            </div>
                            <button type="button" class="primary-action slim" @onclick='() => Navigation.NavigateTo("/backoffice")'>
                                Open Backoffice
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="account-detail-card account-modal-card">
                            <span class="avatar account-modal-avatar" aria-hidden="true">@CurrentAvatarLabel</span>
                            <div>
                                <div class="mini-label">Signed in as</div>
                                <strong>@CurrentDisplayNameOrFallback</strong>
                                <small>@CurrentUsernameOrFallback</small>
                            </div>
                            <button type="button" class="primary-action slim" @onclick='() => Navigation.NavigateTo("/backoffice")'>
                                Manage profile
                            </button>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    @if (isFaqModalOpen)
    {
        <div class="modal-backdrop app-modal-backdrop" role="presentation" @onclick="CloseFaqModal">
            <section class="confirm-dialog app-modal faq-modal" role="dialog" aria-modal="true" aria-labelledby="faq-modal-title" @onclick:stopPropagation="true">
                <header class="app-modal-header">
                    <div>
                        <div class="eyebrow">Knowledge base</div>
                        <h3 id="faq-modal-title">Frequently Asked Questions</h3>
                    </div>
                    <button type="button" class="ghost-button modal-close-button" aria-label="Close FAQ dialog" @onclick="CloseFaqModal">
                        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 6 6 18" />
                            <path d="m6 6 12 12" />
                        </svg>
                    </button>
                </header>

                <div class="faq-modal-body">
                    <div class="faq-modal-summary">
                        <div>
                            <strong>@FilteredFaqItems.Count questions</strong>
                            <span>Showing @FaqPageStart-@FaqPageEnd</span>
                        </div>
                        <div class="faq-filter-wrap">
                            <button type="button"
                                    class="ghost-button faq-filter-button @(isFaqFilterOpen || HasFaqFilter ? "active" : null)"
                                    aria-expanded="@isFaqFilterOpen"
                                    @onclick="ToggleFaqFilter">
                                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 5h18" />
                                    <path d="M6 12h12" />
                                    <path d="M10 19h4" />
                                </svg>
                                <span>Filter</span>
                            </button>

                            @if (isFaqFilterOpen)
                            {
                                <div class="faq-filter-popover">
                                    <label for="faq-filter-input">Search questions</label>
                                    <input id="faq-filter-input"
                                           class="text-input"
                                           placeholder="Type keyword..."
                                           value="@FaqSearchTerm"
                                           @oninput="OnFaqSearchChanged" />
                                    @if (HasFaqFilter)
                                    {
                                        <button type="button" class="ghost-button" @onclick="ClearFaqFilter">Clear filter</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <section class="faq-modal-list" aria-label="Frequently asked questions">
                        @if (FilteredFaqItems.Count == 0)
                        {
                            <div class="faq-modal-empty">
                                <strong>No questions found</strong>
                                <span>Try another keyword.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var item in PagedFaqItems)
                            {
                                <details class="faq-modal-item" open="@IsFaqItemExpanded(item)">
                                    <summary @onclick:preventDefault="true" @onclick="() => ToggleFaqItem(item)">
                                        <span>@item.Question</span>
                                        <small>@item.Category</small>
                                    </summary>
                                    <p>@item.Answer</p>
                                </details>
                            }
                        }
                    </section>

                    @if (FaqTotalPages > 1)
                    {
                        <nav class="faq-modal-pagination" aria-label="FAQ pagination">
                            <button type="button" class="ghost-button" disabled="@(FaqSafeCurrentPage == 1)" @onclick="PreviousFaqPage">Previous</button>
                            <div class="faq-page-dots">
                                @foreach (var pageNumber in VisibleFaqPages)
                                {
                                    <button type="button"
                                            class="faq-page-number @(pageNumber == FaqSafeCurrentPage ? "active" : null)"
                                            @onclick="() => GoToFaqPage(pageNumber)">
                                        @pageNumber
                                    </button>
                                }
                            </div>
                            <button type="button" class="ghost-button" disabled="@(FaqSafeCurrentPage == FaqTotalPages)" @onclick="NextFaqPage">Next</button>
                        </nav>
                    }
                </div>
            </section>
        </div>
    }

    @if (pendingReportMessage is not null)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CancelReportConfirmation">
            <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="report-dialog-title" @onclick:stopPropagation="true">
                <div class="confirm-dialog-icon">
                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 4v16" />
                        <path d="M5 5h11l-1.5 4L16 13H5" />
                    </svg>
                </div>
                <div class="confirm-dialog-content">
                    <div class="eyebrow">Report response</div>
                    <h3 id="report-dialog-title">Send this answer for review?</h3>
                    <p>This will save the user question and assistant response so it can be checked in the backoffice.</p>
                </div>
                <div class="confirm-dialog-actions">
                    <button type="button" class="ghost-button" @onclick="CancelReportConfirmation">Cancel</button>
                    <button type="button" class="primary-action danger-action" disabled="@isBusy" @onclick="ConfirmReportAsync">
                        @(isBusy ? "Reporting..." : "Report")
                    </button>
                </div>
            </section>
        </div>
    }

    @if (pendingContinueMessage is not null)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CancelContinueConfirmation">
            <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="continue-dialog-title" @onclick:stopPropagation="true">
                <div class="confirm-dialog-icon continue-dialog-icon">
                    <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h12" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>
                </div>
                <div class="confirm-dialog-content">
                    <div class="eyebrow">Continue response</div>
                    <h3 id="continue-dialog-title">Continue this answer?</h3>
                    <p>This will ask the assistant to finish the response from where it was cut off.</p>
                </div>
                <div class="confirm-dialog-actions">
                    <button type="button" class="ghost-button" @onclick="CancelContinueConfirmation">Cancel</button>
                    <button type="button" class="primary-action" disabled="@isStreaming" @onclick="ConfirmContinueAsync">
                        @(isStreaming ? "Continuing..." : "Continue")
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private const string TokenStorageKey = "aichatapp.web.token";
    private const string UserStorageKey = "aichatapp.web.username";
    private const string DisplayNameStorageKey = "aichatapp.web.displayName";
    private const string AvatarLabelStorageKey = "aichatapp.web.avatarLabel";
    private const string ConversationStorageKey = "aichatapp.web.conversations";
    private const string ThemeStorageKey = "aichatapp.web.theme";
    private const int AutoScrollThreshold = 120;
    private const int DefaultFaqPageSize = 5;
    private readonly List<ConversationViewModel> Conversations = [];
    private ConversationViewModel ActiveConversation = new();
    private readonly LoginFormModel loginModel = new();
    private readonly RegisterFormModel registerModel = new();
    private ElementReference messageRailRef;
    private string? copiedMessageId;
    private string? reportedMessageId;
    private string? speakingMessageId;
    private MessageViewModel? pendingReportMessage;
    private MessageViewModel? pendingContinueMessage;

    private TwoFactorSetupResponse? twoFactorSetup;
    private bool showRegister;
    private bool isBusy;
    private bool isStreaming;
    private bool initialized;
    private string? token;
    private string? CurrentUsername;
    private string? CurrentDisplayName;
    private string? CurrentAvatar;
    private string promptText = string.Empty;
    private string twoFactorCode = string.Empty;
    private string? AuthMessage;
    private string? ChatStatus;
    private string? CompletionNotice;
    private string? TwoFactorStatus;
    private bool isTwoFactorEnabled;
    private bool messageRailRegistered;
    private bool pendingScrollToLatest;
    private bool forceNextScrollToLatest;
    private bool isSidebarOpen;
    private bool isSidebarNavHidden;
    private bool isAuthModalOpen;
    private bool isSecurityModalOpen;
    private bool isAccountDetailModalOpen;
    private bool isFaqModalOpen;
    private bool isLightTheme;
    private bool workspaceSectionOpen;
    private bool conversationsSectionOpen = true;
    private bool accountSectionOpen;
    private string activeAccountPanel = "profile";
    private IReadOnlyList<FaqItemViewModel> FaqItems = [];
    private int CurrentFaqPage = 1;
    private int CurrentFaqPageSize = DefaultFaqPageSize;
    private string? expandedFaqQuestion;
    private string FaqSearchTerm = string.Empty;
    private bool isFaqFilterOpen;
    private AssistantProfileOptions AssistantProfile => AssistantProfileOptionsAccessor.Value;
    private FrontendOptions FrontendOptions => FrontendOptionsAccessor.Value;

    private bool IsAuthenticated => !string.IsNullOrWhiteSpace(token);
    private string CurrentUsernameOrFallback => string.IsNullOrWhiteSpace(CurrentUsername) ? "You" : CurrentUsername;
    private string CurrentDisplayNameOrFallback => string.IsNullOrWhiteSpace(CurrentDisplayName) ? CurrentUsernameOrFallback : CurrentDisplayName;
    private string CurrentAvatarLabel => IsAuthenticated ? BuildAvatarLabel(CurrentAvatar, CurrentDisplayNameOrFallback, CurrentUsernameOrFallback) : "AI";
    private string SecurityPillText => isTwoFactorEnabled ? "Enabled" : twoFactorSetup is not null ? "Setup in progress" : "Not enabled";
    private string SecurityPillClass => isTwoFactorEnabled ? "enabled" : twoFactorSetup is not null ? "pending" : "idle";
    private bool HasFaqFilter => !string.IsNullOrWhiteSpace(FaqSearchTerm);
    private List<FaqItemViewModel> FilteredFaqItems => FaqItems
        .Where(MatchesFaqSearch)
        .ToList();

    private int FaqPageSize => Math.Max(1, CurrentFaqPageSize);
    private int FaqTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredFaqItems.Count / (double)FaqPageSize));
    private int FaqSafeCurrentPage => Math.Clamp(CurrentFaqPage, 1, FaqTotalPages);
    private int FaqPageStart => FilteredFaqItems.Count == 0 ? 0 : ((FaqSafeCurrentPage - 1) * FaqPageSize) + 1;
    private int FaqPageEnd => FilteredFaqItems.Count == 0 ? 0 : Math.Min(FaqSafeCurrentPage * FaqPageSize, FilteredFaqItems.Count);

    private List<FaqItemViewModel> PagedFaqItems => FilteredFaqItems
        .Skip((FaqSafeCurrentPage - 1) * FaqPageSize)
        .Take(FaqPageSize)
        .ToList();

    private IEnumerable<int> VisibleFaqPages
    {
        get
        {
            var start = Math.Max(1, FaqSafeCurrentPage - 2);
            var end = Math.Min(FaqTotalPages, start + 4);
            start = Math.Max(1, end - 4);

            for (var page = start; page <= end; page++)
            {
                yield return page;
            }
        }
    }

    protected override void OnInitialized()
    {
        FaqItems = FaqContent.LoadQuickAnswers();
        ResetConversationWorkspace();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            token = await BrowserStorage.GetAsync(TokenStorageKey);
            CurrentUsername = await BrowserStorage.GetAsync(UserStorageKey);
            CurrentDisplayName = await BrowserStorage.GetAsync(DisplayNameStorageKey);
            CurrentAvatar = await BrowserStorage.GetAsync(AvatarLabelStorageKey);
            var storedTheme = await BrowserStorage.GetAsync(ThemeStorageKey);
            isLightTheme = string.Equals(storedTheme, "light", StringComparison.OrdinalIgnoreCase);
            await ApplyThemeAsync();

            if (IsAuthenticated)
            {
                OpenSidebarSection(SidebarSection.Conversations);
                await RestoreConversationsAsync();
                AuthMessage = "Session restored. You can continue chatting or update 2FA.";
                await RefreshTwoFactorStatusAsync();
                QueueScrollToLatest(force: true);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                OpenSidebarSection(SidebarSection.Account);
                isAuthModalOpen = true;
                ResetConversationWorkspace();
            }
        }

        await EnsureMessageRailTrackingAsync();
        await FlushPendingScrollAsync();
    }

    private async Task StartNewConversationAsync()
    {
        var conversation = new ConversationViewModel();
        Conversations.Insert(0, conversation);
        ActiveConversation = conversation;
        ChatStatus = null;
        promptText = string.Empty;
        QueueScrollToLatest(force: true);
        PersistConversations();
        await Task.CompletedTask;
    }

    private async Task SelectConversationAsync(string conversationId)
    {
        var match = Conversations.FirstOrDefault(x => x.Id == conversationId);
        if (match is not null)
        {
            ActiveConversation = match;
            ChatStatus = null;
            QueueScrollToLatest(force: true);
            PersistConversations();
        }

        await Task.CompletedTask;
    }

    private async Task NavigateFromSidebarAsync(string uri)
    {
        Navigation.NavigateTo(uri);
        await Task.CompletedTask;
    }

    private async Task OpenFaqModalAsync()
    {
        OpenSidebarSection(SidebarSection.Workspaces);
        CurrentFaqPage = 1;
        expandedFaqQuestion = null;
        await UpdateFaqPageSizeAsync();
        isFaqModalOpen = true;
        await CloseSidebarForAccountModalOnCompactViewportAsync();
    }

    private void CloseFaqModal()
    {
        isFaqModalOpen = false;
        isFaqFilterOpen = false;
        expandedFaqQuestion = null;
    }

    private void PreviousFaqPage()
    {
        CurrentFaqPage = Math.Max(1, FaqSafeCurrentPage - 1);
        expandedFaqQuestion = null;
    }

    private void NextFaqPage()
    {
        CurrentFaqPage = Math.Min(FaqTotalPages, FaqSafeCurrentPage + 1);
        expandedFaqQuestion = null;
    }

    private void GoToFaqPage(int page)
    {
        CurrentFaqPage = Math.Clamp(page, 1, FaqTotalPages);
        expandedFaqQuestion = null;
    }

    private void ToggleFaqFilter()
        => isFaqFilterOpen = !isFaqFilterOpen;

    private void OnFaqSearchChanged(ChangeEventArgs args)
    {
        FaqSearchTerm = args.Value?.ToString() ?? string.Empty;
        CurrentFaqPage = 1;
        expandedFaqQuestion = null;
    }

    private void ClearFaqFilter()
    {
        FaqSearchTerm = string.Empty;
        CurrentFaqPage = 1;
        expandedFaqQuestion = null;
    }

    private bool MatchesFaqSearch(FaqItemViewModel item)
    {
        if (string.IsNullOrWhiteSpace(FaqSearchTerm))
        {
            return true;
        }

        return item.Question.Contains(FaqSearchTerm, StringComparison.OrdinalIgnoreCase)
               || item.Answer.Contains(FaqSearchTerm, StringComparison.OrdinalIgnoreCase)
               || item.Category.Contains(FaqSearchTerm, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsFaqItemExpanded(FaqItemViewModel item)
        => string.Equals(expandedFaqQuestion, item.Question, StringComparison.Ordinal);

    private void ToggleFaqItem(FaqItemViewModel item)
        => expandedFaqQuestion = IsFaqItemExpanded(item) ? null : item.Question;

    private async Task UpdateFaqPageSizeAsync()
    {
        var pageSize = await JS.InvokeAsync<int>("aiChatUi.getFaqModalPageSize");
        CurrentFaqPageSize = Math.Clamp(pageSize, 2, DefaultFaqPageSize);
        CurrentFaqPage = Math.Clamp(CurrentFaqPage, 1, FaqTotalPages);
    }

    private void ToggleSidebar()
    {
        if (isSidebarNavHidden)
        {
            isSidebarNavHidden = false;
            isSidebarOpen = true;
            return;
        }

        if (!isSidebarOpen)
        {
            isSidebarOpen = true;
        }
    }

    private void HideSidebarNav()
    {
        isSidebarNavHidden = true;
        isSidebarOpen = false;
    }

    private async Task CloseSidebarForAccountModalOnCompactViewportAsync()
    {
        if (!isSidebarOpen)
        {
            return;
        }

        var isCompactViewport = await JS.InvokeAsync<bool>("aiChatUi.isCompactViewport");
        if (isCompactViewport)
        {
            isSidebarOpen = false;
        }
    }

    private async Task ToggleThemeAsync()
    {
        isLightTheme = !isLightTheme;
        await BrowserStorage.SetAsync(ThemeStorageKey, isLightTheme ? "light" : "dark");
        await ApplyThemeAsync();
    }

    private ValueTask ApplyThemeAsync()
        => JS.InvokeVoidAsync("aiChatUi.applyTheme", isLightTheme ? "light" : "dark");

    private void ToggleSidebarSection(SidebarSection section)
    {
        var shouldOpen = section switch
        {
            SidebarSection.Conversations => !conversationsSectionOpen,
            SidebarSection.Workspaces => !workspaceSectionOpen,
            SidebarSection.Account => !accountSectionOpen,
            _ => false
        };

        conversationsSectionOpen = shouldOpen && section == SidebarSection.Conversations;
        workspaceSectionOpen = shouldOpen && section == SidebarSection.Workspaces;
        accountSectionOpen = shouldOpen && section == SidebarSection.Account;
    }

    private void OpenSidebarSection(SidebarSection section)
    {
        if (!IsAuthenticated && section == SidebarSection.Conversations)
        {
            section = SidebarSection.Account;
        }

        conversationsSectionOpen = section == SidebarSection.Conversations;
        workspaceSectionOpen = section == SidebarSection.Workspaces;
        accountSectionOpen = section == SidebarSection.Account;
    }

    private async Task OpenAuthModalAsync()
    {
        OpenSidebarSection(SidebarSection.Account);
        isAuthModalOpen = true;
        await CloseSidebarForAccountModalOnCompactViewportAsync();
    }

    private void CloseAuthModal()
        => isAuthModalOpen = false;

    private async Task OpenProfileModalAsync()
    {
        activeAccountPanel = "profile";
        OpenSidebarSection(SidebarSection.Account);
        isAccountDetailModalOpen = true;
        await CloseSidebarForAccountModalOnCompactViewportAsync();
    }

    private async Task OpenPreferencesModalAsync()
    {
        activeAccountPanel = "preferences";
        OpenSidebarSection(SidebarSection.Account);
        isAccountDetailModalOpen = true;
        await CloseSidebarForAccountModalOnCompactViewportAsync();
    }

    private void CloseAccountDetailModal()
        => isAccountDetailModalOpen = false;

    private async Task OpenSecurityModal()
    {
        if (!EnsureAuthenticated())
        {
            await OpenAuthModalAsync();
            return;
        }

        activeAccountPanel = "security";
        OpenSidebarSection(SidebarSection.Account);
        isSecurityModalOpen = true;
        await CloseSidebarForAccountModalOnCompactViewportAsync();
        await RefreshTwoFactorStatusAsync();
    }

    private void CloseSecurityModal()
        => isSecurityModalOpen = false;

    private void BeginConversationRename(ConversationViewModel conversation)
    {
        foreach (var item in Conversations)
        {
            item.IsRenaming = false;
        }

        conversation.DraftTitle = conversation.Title;
        conversation.IsRenaming = true;
    }

    private void CancelConversationRename(ConversationViewModel conversation)
    {
        conversation.IsRenaming = false;
        conversation.DraftTitle = conversation.Title;
    }

    private void SaveConversationTitle(ConversationViewModel conversation)
    {
        conversation.Title = string.IsNullOrWhiteSpace(conversation.DraftTitle)
            ? "New conversation"
            : conversation.DraftTitle.Trim();
        conversation.HasCustomTitle = true;
        conversation.IsRenaming = false;
        PersistConversations();
    }

    private Task HandleRenameKeyDown(KeyboardEventArgs args, ConversationViewModel conversation)
    {
        if (args.Key == "Enter")
        {
            SaveConversationTitle(conversation);
        }
        else if (args.Key == "Escape")
        {
            CancelConversationRename(conversation);
        }

        return Task.CompletedTask;
    }

    private void DeleteConversation(ConversationViewModel conversation)
    {
        var wasActive = ActiveConversation.Id == conversation.Id;
        Conversations.Remove(conversation);

        if (Conversations.Count == 0)
        {
            var replacement = new ConversationViewModel();
            Conversations.Add(replacement);
            ActiveConversation = replacement;
        }
        else if (wasActive)
        {
            ActiveConversation = Conversations[0];
        }

        ChatStatus = null;
        PersistConversations();
    }

    private async Task RegisterAsync()
    {
        await RunBusyAction(async cancellationToken =>
        {
            var message = await GatewayClient.RegisterAsync(new RegisterPayload
            {
                Username = registerModel.Username.Trim(),
                Email = registerModel.Email.Trim(),
                Password = registerModel.Password
            }, cancellationToken);

            AuthMessage = $"{message} You can sign in now.";
            showRegister = false;
            registerModel.Password = string.Empty;
        });
    }

    private async Task LoginAsync()
    {
        await RunBusyAction(async cancellationToken =>
        {
            var issuedToken = await GatewayClient.LoginAsync(new LoginPayload
            {
                Username = loginModel.Username.Trim(),
                Password = loginModel.Password,
                OtpCode = string.IsNullOrWhiteSpace(loginModel.OtpCode) ? null : loginModel.OtpCode.Trim()
            }, cancellationToken);

            token = issuedToken;
            CurrentUsername = loginModel.Username.Trim();
            CurrentDisplayName = await BrowserStorage.GetAsync(DisplayNameStorageKey);
            CurrentAvatar = await BrowserStorage.GetAsync(AvatarLabelStorageKey);
            await BrowserStorage.SetAsync(TokenStorageKey, token);
            await BrowserStorage.SetAsync(UserStorageKey, CurrentUsername);
            await RestoreConversationsAsync();

            loginModel.Password = string.Empty;
            loginModel.OtpCode = string.Empty;
            AuthMessage = AssistantProfile.SignedInMessage;
            ChatStatus = null;
            isAuthModalOpen = false;
            OpenSidebarSection(SidebarSection.Conversations);
            activeAccountPanel = "profile";
            await RefreshTwoFactorStatusAsync(cancellationToken);
        });
    }

    private async Task LogoutAsync()
    {
        token = null;
        CurrentUsername = null;
        CurrentDisplayName = null;
        CurrentAvatar = null;
        twoFactorSetup = null;
        twoFactorCode = string.Empty;
        await BrowserStorage.RemoveAsync(TokenStorageKey);
        await BrowserStorage.RemoveAsync(UserStorageKey);
        ResetConversationWorkspace();
        AuthMessage = "Signed out.";
        ChatStatus = "Sign back in to stream through the authenticated flow.";
        isTwoFactorEnabled = false;
        TwoFactorStatus = null;
        isSecurityModalOpen = false;
        isAuthModalOpen = true;
        OpenSidebarSection(SidebarSection.Account);
    }

    private async Task SetupTwoFactorAsync()
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        Logger.LogInformation("Enable 2FA setup clicked for user {User}.", CurrentUsernameOrFallback);
        await RunBusyAction(async cancellationToken =>
        {
            twoFactorSetup = await GatewayClient.SetupTwoFactorAsync(token!, cancellationToken);
            isTwoFactorEnabled = false;
            twoFactorCode = string.Empty;
            AuthMessage = "Authenticator setup generated.";
            TwoFactorStatus = "QR code ready. Enter the current 6-digit code from Google Authenticator.";
        });
    }

    private async Task VerifyTwoFactorAsync()
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        var normalizedCode = twoFactorCode?.Trim() ?? string.Empty;
        Logger.LogInformation("Enable 2FA verify clicked for user {User}. Code length: {CodeLength}", CurrentUsernameOrFallback, normalizedCode.Length);
        await RunBusyAction(async cancellationToken =>
        {
            var message = await GatewayClient.VerifyTwoFactorAsync(token!, normalizedCode, cancellationToken);
            AuthMessage = message;
            TwoFactorStatus = message;
            isTwoFactorEnabled = true;
            twoFactorSetup = null;
            twoFactorCode = string.Empty;
        });
    }

    private async Task DisableTwoFactorAsync()
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        Logger.LogInformation("Disable 2FA clicked for user {User}.", CurrentUsernameOrFallback);
        await RunBusyAction(async cancellationToken =>
        {
            var normalizedCode = twoFactorCode?.Trim() ?? string.Empty;
            var message = await GatewayClient.DisableTwoFactorAsync(token!, normalizedCode, cancellationToken);
            AuthMessage = message;
            TwoFactorStatus = message;
            isTwoFactorEnabled = false;
            twoFactorCode = string.Empty;
            twoFactorSetup = null;
        });
    }

    private void CancelTwoFactorSetup()
    {
        twoFactorSetup = null;
        twoFactorCode = string.Empty;
        TwoFactorStatus = null;
    }

    private async Task SendPromptAsync()
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        var trimmedPrompt = promptText.Trim();
        if (string.IsNullOrWhiteSpace(trimmedPrompt))
        {
            return;
        }

        promptText = string.Empty;
        ChatStatus = null;
        isStreaming = true;

        var userMessage = new MessageViewModel
        {
            Role = "user",
            Content = trimmedPrompt,
            CreatedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now
        };

        var assistantMessage = new MessageViewModel
        {
            Role = "assistant",
            Content = string.Empty,
            IsStreaming = true,
            CreatedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now
        };

        ActiveConversation.Messages.Add(userMessage);
        ActiveConversation.Messages.Add(assistantMessage);
        if (!ActiveConversation.HasCustomTitle && IsDefaultConversationTitle(ActiveConversation.Title))
        {
            ActiveConversation.Title = BuildConversationTitle(trimmedPrompt);
        }
        QueueScrollToLatest(force: true);
        await PersistConversationsAsync();
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));

            await foreach (var streamEvent in GatewayClient.StreamChatAsync(
                token!,
                new ChatRequestPayload
                {
                    ChatId = ActiveConversation.Id,
                    User = CurrentUsernameOrFallback,
                    Prompt = trimmedPrompt,
                    ContextMode = "documentation"
                },
                cts.Token))
            {
                if (streamEvent.EventName == "token")
                {
                    assistantMessage.Content += streamEvent.Content;
                    QueueScrollToLatest();
                }
                else if (streamEvent.EventName == "complete")
                {
                    assistantMessage.Content = streamEvent.Content;
                    assistantMessage.IsStreaming = false;
                    assistantMessage.LastUpdatedAt = DateTimeOffset.Now;
                    ChatStatus = AssistantProfile.ResponseCompleteStatus;
                    QueueScrollToLatest();
                    await ShowCompletionNotificationAsync(AssistantProfile.AnswerCompleteNotification);
                }

                await InvokeAsync(StateHasChanged);
            }

            assistantMessage.IsStreaming = false;
            await PersistConversationsAsync();
        }
        catch (Exception ex)
        {
            if (IsInvalidSessionError(ex))
            {
                await EndInvalidSessionAsync(ex.Message);
                return;
            }

            assistantMessage.IsStreaming = false;
            assistantMessage.Content = string.IsNullOrWhiteSpace(assistantMessage.Content)
                ? "I hit an error before the response could finish streaming."
                : assistantMessage.Content;
            ChatStatus = ex.Message;
            await PersistConversationsAsync();
        }
        finally
        {
            isStreaming = false;
            await PersistConversationsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SendPromptSubmitAsync()
        => SendPromptAsync();

