    private static bool IsDefaultConversationTitle(string title)
        => string.IsNullOrWhiteSpace(title) || string.Equals(title, "New conversation", StringComparison.Ordinal);

    private static string BuildDefaultAvatarLabel(string displayName)
    {
        var parts = displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
            .ToArray();

        return parts.Length == 0 ? "You" : new string(parts);
    }

    private static string BuildAvatarLabel(string? savedAvatar, string displayName, string username)
    {
        if (!string.IsNullOrWhiteSpace(savedAvatar))
        {
            var normalizedSavedAvatar = NormalizeAvatarLabel(savedAvatar, fallback: string.Empty);
            if (normalizedSavedAvatar.Length >= 2)
            {
                return normalizedSavedAvatar;
            }

            if (string.Equals(normalizedSavedAvatar, "A", StringComparison.Ordinal))
            {
                return "GB";
            }
        }

        var displayInitials = BuildDefaultAvatarLabel(displayName);
        if (!string.Equals(displayInitials, "You", StringComparison.Ordinal))
        {
            return displayInitials;
        }

        return BuildUsernameAvatarLabel(username);
    }

    private static string BuildUsernameAvatarLabel(string username)
    {
        var normalized = username.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "U";
        }

        var letters = normalized
            .Where(char.IsLetterOrDigit)
            .Take(2)
            .Select(char.ToUpperInvariant)
            .ToArray();

        return letters.Length == 0 ? "U" : new string(letters);
    }

    private static string NormalizeAvatarLabel(string value, string fallback)
    {
        var letters = value
            .Trim()
            .Where(char.IsLetterOrDigit)
            .Take(2)
            .Select(char.ToUpperInvariant)
            .ToArray();

        return letters.Length == 0 ? fallback : new string(letters);
    }

