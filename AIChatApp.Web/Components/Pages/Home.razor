        twoFactorCode = string.Empty;
        TwoFactorStatus = null;
    }

    private async Task SendPromptAsync()
    {
        if (!EnsureAuthenticated())
        {
            return;
        }

        var trimmedPrompt = promptText.Trim();
        if (string.IsNullOrWhiteSpace(trimmedPrompt))
        {
            return;
        }

        promptText = string.Empty;
        ChatStatus = null;
        isStreaming = true;

        var userMessage = new MessageViewModel
        {
            Role = "user",
            Content = trimmedPrompt,
            CreatedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now
        };

        var assistantMessage = new MessageViewModel
        {
            Role = "assistant",
            Content = string.Empty,
            IsStreaming = true,
            CreatedAt = DateTimeOffset.Now,
            LastUpdatedAt = DateTimeOffset.Now
        };

        ActiveConversation.Messages.Add(userMessage);
        ActiveConversation.Messages.Add(assistantMessage);
        if (!ActiveConversation.HasCustomTitle && IsDefaultConversationTitle(ActiveConversation.Title))
        {
            ActiveConversation.Title = BuildConversationTitle(trimmedPrompt);
        }
        QueueScrollToLatest(force: true);
        await PersistConversationsAsync();
        StateHasChanged();

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));

            await foreach (var streamEvent in GatewayClient.StreamChatAsync(
                token!,
                new ChatRequestPayload
                {
                    ChatId = ActiveConversation.Id,
                    User = CurrentUsernameOrFallback,
                    Prompt = trimmedPrompt,
                    ContextMode = "documentation"
                },
                cts.Token))
            {
                if (streamEvent.EventName == "token")
                {
                    assistantMessage.Content += streamEvent.Content;
                    QueueScrollToLatest();
                }
                else if (streamEvent.EventName == "complete")
                {
                    assistantMessage.Content = streamEvent.Content;
                    assistantMessage.IsStreaming = false;
                    assistantMessage.LastUpdatedAt = DateTimeOffset.Now;
                    ChatStatus = AssistantProfile.ResponseCompleteStatus;
                    QueueScrollToLatest();
                    await ShowCompletionNotificationAsync(AssistantProfile.AnswerCompleteNotification);
                }

                await InvokeAsync(StateHasChanged);
            }

            assistantMessage.IsStreaming = false;
            await PersistConversationsAsync();
        }
        catch (Exception ex)
        {
            assistantMessage.IsStreaming = false;
            assistantMessage.Content = string.IsNullOrWhiteSpace(assistantMessage.Content)
                ? "I hit an error before the response could finish streaming."
                : assistantMessage.Content;
            ChatStatus = ex.Message;
            await PersistConversationsAsync();
        }
        finally
        {
            isStreaming = false;
            await PersistConversationsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task SendPromptSubmitAsync()
        => SendPromptAsync();

