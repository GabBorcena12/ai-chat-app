{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiSettings": {
    "WhitelistedIPs": [
      "127.0.0.1",
      "::1"
    ]
  },
  "ApiKey.Settings": {
    "ClientName": "GajiTechClient",
    "Keys": [
      "gaji-tech-secret-key-endpoint-0001"
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "AiChatRoute": {
        "ClusterId": "AiChatCluster",
        "Match": {
          "Path": "/aichat/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/aichat" },
          { "PathPrefix": "/api/aichat" }
        ]
      },
      "ChatHistoryRoute": {
        "ClusterId": "ChatHistoryCluster",
        "Match": {
          "Path": "/chathistory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/chathistory" },
          { "PathPrefix": "/api/chathistory" }
        ]
      }
    },
    "Clusters": {
      "AiChatCluster": {
        "Destinations": {
          "aichatApi": {
            "Address": "http://aichat-api:8080/" // check launchsettings port for Container (Dockerfile) profile
          }
        }
      },
      "ChatHistoryCluster": {
        "Destinations": {
          "chatHistoryApi": {
            "Address": "http://aichat-api:8080/"
          }
        }
      }
    }
  }
}