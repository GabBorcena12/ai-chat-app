{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiSettings": {
    "WhitelistedIPs": [
      "127.0.0.1",
      "::1",
      "::ffff:172.18.0.1",
      "::ffff:172.18.0.2"
    ]
  },
  "ApiKey.Settings": {
    "ClientName": "GajiTechClient",
    "Keys": []
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Limit": 100,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "ChatRoute": {
        "ClusterId": "ChatCluster",
        "Match": {
          "Path": "/chat/{**catch-all}"
        },
        "TimeoutPolicy": "Disable",
        "Transforms": [
          { "PathRemovePrefix": "/chat" },
          { "PathPrefix": "/api/chat" }
        ]
      },
      "AuthRoute": {
        "ClusterId": "AuthCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "PathPrefix": "/api/auth" }
        ]
      },
      "ChatHistoryRoute": {
        "ClusterId": "ChatHistoryCluster",
        "Match": {
          "Path": "/chathistory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/chathistory" },
          { "PathPrefix": "/api/chathistory" }
        ]
      },
      "BackofficeRoute": {
        "ClusterId": "BackofficeCluster",
        "Match": {
          "Path": "/backoffice/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/backoffice" },
          { "PathPrefix": "/api/backoffice" }
        ]
      }
    },
    "Clusters": {
      "ChatCluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "chatApi": {
            // IMPORTANT:
            // When running inside Docker, always use the CONTAINER port (e.g., 8080), not the host port (e.g., 5157).
            // Containers communicate through the Docker network using internal ports.
            // Check launchSettings.json → "Container (Dockerfile)" profile to confirm the container port.
            // Example: Gateway should call API using http://<container-name>:8080
            "Address": "http://aichatapp-api:8080/"
          }
        }
      },
      "AuthCluster": {
        "Destinations": {
          "authApi": {
            // IMPORTANT:
            // When running inside Docker, always use the CONTAINER port (e.g., 8080), not the host port (e.g., 5157).
            // Containers communicate through the Docker network using internal ports.
            // Check launchSettings.json → "Container (Dockerfile)" profile to confirm the container port.
            // Example: Gateway should call API using http://<container-name>:8080
            "Address": "http://aichatapp-api:8080/"
          }
        }
      },
      "ChatHistoryCluster": {
        "Destinations": {
          "chatHistoryApi": {
            // IMPORTANT:
            // When running inside Docker, always use the CONTAINER port (e.g., 8080), not the host port (e.g., 5157).
            // Containers communicate through the Docker network using internal ports.
            // Check launchSettings.json → "Container (Dockerfile)" profile to confirm the container port.
            // Example: Gateway should call API using http://<container-name>:8080
            "Address": "http://aichatapp-api:8080/"
          }
        }
      },
      "BackofficeCluster": {
        "Destinations": {
          "backofficeApi": {
            "Address": "http://aichatapp-api:8080/"
          }
        }
      }
    }
  }
}
